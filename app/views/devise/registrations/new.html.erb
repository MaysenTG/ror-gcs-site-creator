<div class="auth-shell">
  <div class="auth-shell__copy">
    <h1>Create with Gusto Cloud</h1>
    <p>Register once, then create static sites, edit them in the browser, and publish instantly.</p>
    <ul class="auth-shell__perks">
      <li>Free plan to start</li>
      <li>In-browser code editor</li>
      <li>Live preview URLs for every site</li>
    </ul>
  </div>
  <div class="auth-panel">
    <h2 class="h3 mb-1">Create account</h2>
    <p class="text-muted mb-4">Takes about a minute. No credit card required.</p>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: "false" }) do |f| %>
      <%= render partial: "devise/shared/error_messages", resource: resource %>
      <div class="mb-3">
        <label class="form-label" for="signupFormFirstName">Full name</label>
        <input type="text" id="signupFormFirstName" placeholder="Ada Lovelace" name="account[name]" class="form-control" autocomplete="name" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="signupFormEmail">Email</label>
        <input type="email" id="signupFormEmail" placeholder="you@example.com" name="account[email]" class="form-control" autocomplete="email" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="signupFormPass">Password</label>
        <input type="password" id="signupFormPass" name="account[password]" class="form-control" autocomplete="new-password" required minlength="6">
        <div class="form-text">At least 6 characters.</div>
      </div>
      <div class="mb-4">
        <label class="form-label" for="signupFormPassConf">Confirm password</label>
        <input type="password" id="signupFormPassConf" name="account[password_confirmation]" class="form-control" autocomplete="new-password" required minlength="6">
      </div>
      <button type="submit" class="btn btn-primary w-100">Create account</button>
      <a href="/accounts/sign_in" class="auth-switch">Already registered? Sign in</a>
    <% end %>
  </div>
</div>
