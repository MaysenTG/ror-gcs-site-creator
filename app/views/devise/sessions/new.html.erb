<div class="auth-shell">
  <div class="auth-shell__copy">
    <h1>Welcome back</h1>
    <p>Sign in to open your sites, edit files, and publish updates to Cloudflare R2.</p>
  </div>
  <div class="auth-panel">
    <h2 class="h3 mb-4">Sign in</h2>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= render partial: "devise/shared/error_messages", resource: resource %>
      <div class="mb-3">
        <label class="form-label" for="signupFormEmail">Email</label>
        <input type="email" id="signupFormEmail" <% if request.query_parameters["guest"] %>value="guest@gmail.com"<% end %> placeholder="you@example.com" name="account[email]" class="form-control" autocomplete="email">
      </div>
      <div class="mb-4">
        <label class="form-label" for="signupFormPass">Password</label>
        <input type="password" id="signupFormPass" <% if request.query_parameters["guest"] %>value="password123"<% end %> name="account[password]" class="form-control" autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary w-100">Sign in</button>
      <a href="/accounts/sign_up" class="auth-switch">Need an account? Create one</a>
    <% end %>
  </div>
</div>
