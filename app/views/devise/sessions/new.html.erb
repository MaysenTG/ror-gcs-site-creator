<section class="">
  <!-- Jumbotron -->
  <div class="px-4 py-5 px-md-5 text-center text-lg-start" style="background-color: hsl(0, 0%, 96%)">
    <div class="container">
      <div class="row gx-lg-5 align-items-center">
        <div class="col-lg-3"></div>
        <div class="col-lg-6 mb-5 mb-lg-0">
          <h3 class="h3">Sign in</h3>
          <div class="card">
            <div class="card-body py-5 px-md-5">
              <form action="/accounts/sign_in" accept-charset="UTF-8" method="post">
                <!-- 2 column grid layout with text inputs for the first and last names -->
                <%= render partial: "devise/shared/error_messages", resource: resource %>
                <!-- Email input -->
                <div class="form-outline mb-4">
                  <input type="email" id="signupFormEmail" <% if request.query_parameters["guest"] %>value="guest@gmail.com"<% end %> placeholder="john.smith@gmail.com" name="account[email]" class="form-control" />
                  <label class="form-label" for="signupFormEmail">Email address</label>
                </div>
                <!-- Password input -->
                <div class="form-outline mb-4">
                  <input type="password" id="signupFormPass" <% if request.query_parameters["guest"] %>value="password123"<% end %> name="account[password]" class="form-control" />
                  <label class="form-label" for="signupFormPass">Password</label>
                </div>
                <!-- Submit button -->
                <button type="submit" class="btn btn-primary btn-block w-100 mb-4">
                  Sign in
                </button>
                <span class="w-100 d-flex justify-content-center align-items-center">Or</span>
                <a href="/accounts/sign_up" class="d-flex justify-content-center align-items-center btn-block w-100 mt-4">Create an account</a>
              </form>
            </div>
          </div>
        </div>
        <div class="col-lg-3"></div>
      </div>
    </div>
  </div>
</section>