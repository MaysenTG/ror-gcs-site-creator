<section class="">
  <!-- Jumbotron -->
  <div class="px-4 py-5 px-md-5 text-center text-lg-start" style="background-color: hsl(0, 0%, 96%)">
    <div class="container">
      <div class="row gx-lg-5 align-items-center">
        <div class="col-lg-3"></div>
        <div class="col-lg-6 mb-5 mb-lg-0">
          <h3 class="h3">Sign in</h3>
          <div class="card">
            <div class="card-body py-5 px-md-5">
              <form action="/accounts/sign_in" accept-charset="UTF-8" method="post">
                <!-- 2 column grid layout with text inputs for the first and last names -->
                <%= render partial: "devise/shared/error_messages", resource: resource %>
                <!-- Email input -->
                <div class="form-outline mb-4">
                  <input type="email" id="signupFormEmail" placeholder="john.smith@gmail.com" name="account[email]" class="form-control" />
                  <label class="form-label" for="signupFormEmail">Email address</label>
                </div>
                <!-- Password input -->
                <div class="form-outline mb-4">
                  <input type="password" id="signupFormPass" name="account[password]" class="form-control" />
                  <label class="form-label" for="signupFormPass">Password</label>
                </div>
                <!-- Submit button -->
                <button type="submit" class="btn btn-primary btn-block w-100 mb-4">
                  Sign in
                </button>
                <span class="w-100 d-flex justify-content-center align-items-center">Or</span>
                <a href="/accounts/sign_up" class="d-flex justify-content-center align-items-center btn-block w-100 mt-4">Create an account</a>
              </form>
            </div>
          </div>
        </div>
        <div class="col-lg-3"></div>
      </div>
    </div>
  </div>
</section>
<!-- component -->
<div class="text-center mt-16">
  <div class="flex items-center justify-center">
    <svg fill="none" viewBox="0 0 24 24" class="w-12 h-12 text-blue-500" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
    </svg>
  </div>
  <h2 class="text-4xl tracking-tight">
    Sign in into your account
  </h2>
  <span class="text-sm">or <a href="/accounts/sign_up" class="text-blue-500">
      register a new account
    </a>
  </span>
</div>
<div class="flex justify-center my-2 mx-4 md:mx-0">
  <form class="w-full max-w-xl bg-white rounded-lg shadow-md p-6" action="/accounts/sign_in" accept-charset="UTF-8" method="post">
    <div class="flex flex-wrap -mx-3 mb-6">
      <div class="w-full md:w-full px-3 mb-6">
        <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for='Password'>Email address</label>
        <input name="account[email]" class="appearance-none block w-full bg-white text-gray-900 font-medium border border-gray-400 rounded-lg py-3 px-3 leading-tight focus:outline-none" type='email' required>
      </div>
      <div class="w-full md:w-full px-3 mb-6">
        <label class="block uppercase tracking-wide text-gray-700 text-xs font-bold mb-2" for='Password'>Password</label>
        <input name="account[password]" class="appearance-none block w-full bg-white text-gray-900 font-medium border border-gray-400 rounded-lg py-3 px-3 leading-tight focus:outline-none" type='password' required>
      </div>
      <div class="w-full flex items-center justify-between px-3 mb-3 ">
        <label for="remember" class="flex items-center w-1/2">
          <input name="account[remember_me]" type="checkbox" class="mr-1 bg-white shadow">
          <span class="text-sm text-gray-700 pt-1">Remember Me</span>
        </label>
        <div class="w-1/2 text-right">
          <a href="#" disabled="" class="text-blue-500 text-sm tracking-tight">Forget your password?</a>
        </div>
      </div>
      <div class="w-full md:w-full px-3 mb-6">
        <button class="appearance-none block w-full bg-blue-600 text-gray-100 font-bold border border-gray-200 rounded-lg py-3 px-3 leading-tight hover:bg-blue-500 focus:outline-none focus:bg-white focus:border-gray-500">Sign in</button>
      </div>
      <div class="w-full flex items-center justify-between px-3 mb-3 ">
        <div class="w-100 text-right">
          <a href="/accounts/sign_up" class="text-blue-500 text-sm tracking-tight">Sign up</a>
        </div>
      </div>
    </div>
  </form>
</div>
