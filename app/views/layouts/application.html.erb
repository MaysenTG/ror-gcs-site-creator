<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Static site creator</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= favicon_link_tag %>
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">
    <script src="https://kit.fontawesome.com/a1125b2c11.js" crossorigin="anonymous"></script>
    <%= render partial: "layouts/codemirrorlinks" %>
  </head>
  <body>
    <!-- If the URL contains /accounts, yield, otherwise render React app -->
    <input disabled type="hidden" id="csrf_token" value="<%= form_authenticity_token %>"/>
    
    <%= render "partials/nav" %>
    <main id="main-content">
      <%= yield %>
    </main>
    <%= render "partials/footer" %>
    
    <script src="https://code.jquery.com/jquery-3.6.1.min.js" integrity="sha256-o88AwQnZB+VDvE9tvIXrMQaPlFFSUTR+nldQm1LuPXQ=" crossorigin="anonymous"></script>
  </body>
</html>
