<div class="modal fade" id="deleteFileModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Delete file </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form id="delete-file-form">
                  <input type="hidden" name="site_id" value="<%= @site["id"] %>">
                  <input type="hidden" name="site_name" value="<%= @site["name"] %>">
                  <input type="hidden" name="file_name" id="file_name" value="">
                  <input type="hidden" name="folder_name" id="folder_name" value="">
                </form>
              </div>
            </div>
            Are you sure you want to delete this file? This action cannot be undone.
          </div>
          <div data-controller="file" class="modal-footer">
            <button type="button" class="text-white bg-gray-700 hover:bg-gray-800 focus:ring-4 focus:ring-gray-300 disabled:bg-gray-200 font-medium rounded-lg text-sm px-4 py-2.5" data-bs-dismiss="modal">Cancel</button>
            <button type="button" data-action="file#deleteFile" form="delete-file-form" class="focus:outline-none disabled:bg-red-200 text-white text-sm py-2.5 px-5 rounded-md bg-red-500 hover:bg-red-600 hover:shadow-lg">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Delete file
            </button>
          </div>
        </div>
      </div>
    </div>