<div class="modal fade" id="uploadFileModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Upload a new file </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form id="upload-file-form">
                  <input type="hidden" name="site_id" value="<%= @site["id"] %>">
                  <input type="hidden" name="site_name" value="<%= @site["name"] %>">
                  <div data-controller="validation" class="mb-3">
                    <label for="formFile" class="form-label">Upload a file</label>
                    <input data-action="validation#fileHasBeenSelectedForUpload" class="form-control" type="file" name="file" id="formFile">
                  </div>
                </form>
                <small><strong>Note: </strong>This file will overwrite any file with the same name</small>
              </div>
            </div>
          </div>
          <div data-controller="file" class="modal-footer">
            <button type="button" class="text-white bg-gray-700 hover:bg-gray-800 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 py-2.5" data-bs-dismiss="modal">Cancel</button>
            <button type="button" data-action="file#uploadFile" form="upload-file-form" disabled="" class="focus:outline-none disabled:bg-blue-200 text-white text-sm py-2.5 px-5 rounded-md bg-blue-500">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Upload file
            </button>
          </div>
        </div>
      </div>
    </div>