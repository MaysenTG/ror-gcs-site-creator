<div class="modal fade" id="mainOr404" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Built-in site pages</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p><code>index.html</code> is the home page. Visiting <strong><%= site_public_host(@site) %></strong> serves this file.</p>
        <br>
        <p><code>404.html</code> is shown when a URL has no matching file.</p>
        <br>
        <p><code>password.html</code> is the visitor lock screen when Password &amp; SEO has a gate enabled. You can restyle it, but it can’t be deleted or renamed.</p>
      </div>
      <div data-controller="file" class="modal-footer">
        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
