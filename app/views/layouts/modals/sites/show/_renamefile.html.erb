<div class="modal fade" id="renameFileModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Rename file</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form id="rename-file-form">
                  <input type="hidden" name="site_id" value="<%= @site["id"] %>">
                  <input type="hidden" name="site_name" value="<%= @site["name"] %>">
                  <input type="hidden" name="current_file_name" id="current_file_name" value="">
                  <input type="hidden" name="folder_name" id="folder_name" value="">
                  <div data-controller="validation" class="mb-3">
                    <label for="name" class="form-label">New file name</label>
                    <input type="text" data-action="input->validation#validateAllowFileType" class="form-control" id="new_file_name" name="new_file_name" value="">
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div data-controller="file" class="modal-footer">
            <button type="button" class="text-white bg-gray-700 hover:bg-gray-800 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 py-2.5" data-bs-dismiss="modal">Cancel</button>
            <button type="button" data-action="file#renameFile" form="rename-file-form" class="focus:outline-none text-white text-sm py-2.5 px-5 rounded-md bg-blue-500 disabled:bg-blue-200">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Rename file
            </button>
          </div>
        </div>
      </div>
    </div>