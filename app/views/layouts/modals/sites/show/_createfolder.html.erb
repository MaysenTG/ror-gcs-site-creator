<div data-controller="folder" class="modal fade" id="createFolderModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Create a new folder</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form id="create-folder-form" method="post" action="/admin/sites/<%= @site["name"] %>/folders/new" data-turbo="true">
                  <input type="hidden" name="site_id" value="<%= @site["id"] %>">
                  <input type="hidden" name="site_name" value="<%= @site["name"] %>">
                  <div class="mb-3">
                    <label for="name" class="form-label">Folder name</label>
                    <input data-action="input->folder#validateFolderName" type="text" class="form-control" id="name" name="folder_name">
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="text-white bg-gray-700 hover:bg-gray-800 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 py-2.5" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" disabled="" form="create-folder-form" class="focus:outline-none text-white text-sm py-2.5 px-5 rounded-md bg-blue-500 disabled:bg-blue-200">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Create folder
            </button>
          </div>
        </div>
      </div>
    </div>