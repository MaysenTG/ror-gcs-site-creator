<section class="home-hero">
  <div class="home-hero__bg" aria-hidden="true"></div>
  <div class="container position-relative home-hero__inner">
    <div class="home-hero__content">
      <p class="home-hero__brand">Gusto <em>Cloud</em></p>
      <h1>Build and host static sites from one editor.</h1>
      <p>Write files in the browser, preview themes instantly, and publish to Cloudflare R2 without leaving the tab.</p>
      <div class="home-hero__actions">
        <% if current_account %>
          <a href="/admin/sites" class="btn btn-primary btn-lg">Open your sites</a>
          <a href="/admin/sites/new" class="btn btn-ghost btn-lg">Create a site</a>
        <% else %>
          <a href="/accounts/sign_up" class="btn btn-primary btn-lg">Start free</a>
          <a href="/home/pricing" class="btn btn-ghost btn-lg">See pricing</a>
        <% end %>
      </div>
    </div>
    <div class="home-hero__visual" aria-hidden="true">
      <div class="home-hero__visual-bar"><i></i><i></i><i></i></div>
      <pre class="home-hero__code"><span class="tok-tag">&lt;section</span> <span class="tok-attr">class</span>=<span class="tok-str">"hero"</span><span class="tok-tag">&gt;</span>
  <span class="tok-tag">&lt;h1&gt;</span>Ship a site today<span class="tok-tag">&lt;/h1&gt;</span>
  <span class="tok-tag">&lt;p&gt;</span>Edit HTML, CSS, JS online.<span class="tok-tag">&lt;/p&gt;</span>
<span class="tok-tag">&lt;/section&gt;</span></pre>
    </div>
  </div>
</section>

<section class="home-section">
  <div class="container">
    <h2 class="home-section__title">What you get</h2>
    <p class="home-section__lead">A focused toolkit for static sites — create files, pick a starter theme, and keep everything under your subdomain.</p>
    <div class="feature-rail">
      <article>
        <h3>Browser editor</h3>
        <p>Create, rename, upload, and delete files while you build. HTML, CSS, and JS stay in sync with your live site.</p>
      </article>
      <article>
        <h3>Starter themes</h3>
        <p>Begin from blank, portfolio, or React skeleton templates, then reshape them for your brand.</p>
      </article>
      <article>
        <h3>R2 hosting</h3>
        <p>Sites live on Cloudflare R2 with fast global delivery — no server setup on your plate.</p>
      </article>
    </div>
  </div>
</section>
