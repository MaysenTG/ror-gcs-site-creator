<div class="container col-xxl-8 px-4 py-5">
  <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
    <div class="col-10 col-sm-8 col-lg-6">
      <img src="https://getbootstrap.com/docs/5.1/examples/heroes/bootstrap-themes.png" class="d-block mx-lg-auto img-fluid" alt="Bootstrap Themes" width="700" height="500" loading="lazy">
    </div>
    <div class="col-lg-6">
      <h1 class="display-5 fw-bold lh-1 mb-3">Custom built static websites</h1>
      <p class="lead">Create a static site hosted on Google's global storage service</p>
      <p class="lead">Create, delete, and edit files to fit your brand</p>
      <div class="d-grid gap-2 d-md-flex justify-content-md-start">
        <% if current_account %>
          <a href="/admin/sites" type="button" class="btn btn-primary btn-lg px-4 me-md-2">View your sites</a>
        <% else %>
          <a href="/accounts/sign_up" type="button" class="btn btn-primary btn-lg px-4 me-md-2">Create an account</a>
        <% end %>
      </div>
    </div>
  </div>
</div>
