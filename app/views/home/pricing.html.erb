<div class="page-shell">
  <header class="page-header">
    <div>
      <h1>Plans</h1>
      <p>Grow from a few personal sites to a larger portfolio. Upgrade when you need more room.</p>
    </div>
  </header>

  <div class="pricing-grid">
    <article class="pricing-card">
      <h3>Free</h3>
      <p class="price">$0 <small>/mo</small></p>
      <ul>
        <li>3 sites</li>
        <li>1 MB per site</li>
        <li>Browser editor + themes</li>
      </ul>
      <% if current_account %>
        <a href="/admin/sites" class="btn btn-outline-primary w-100">Go to your sites</a>
      <% else %>
        <a href="/accounts/sign_up" class="btn btn-outline-primary w-100">Start free</a>
      <% end %>
    </article>

    <article class="pricing-card pricing-card--featured">
      <h3>Enthusiast</h3>
      <p class="price">$15 <small>/mo</small></p>
      <ul>
        <li>10 sites</li>
        <li>10 MB per site</li>
        <li>Everything in Free</li>
      </ul>
      <a href="/accounts/get_plans" class="btn btn-primary w-100">Get started</a>
    </article>

    <article class="pricing-card">
      <h3>Enterprise</h3>
      <p class="price">$29 <small>/mo</small></p>
      <ul>
        <li>100 sites</li>
        <li>100 MB per site</li>
        <li>Priority support</li>
      </ul>
      <a href="mailto:greenwood.maysen@gmail.com" class="btn btn-outline-primary w-100">Contact us</a>
    </article>
  </div>
</div>
