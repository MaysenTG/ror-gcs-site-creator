<div class="container">
  <% if notice %>
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
      <%= notice %>
      <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Close"
    ></button>
    </div>
  <% end %>
  <div class="container mt-3">
    <div class="d-flex justify-content-between mb-3 align-items-center">
      <h1 class="font-medium leading-tight text-3xl mt-0 mb-2 text-black-600">
        All sites
      </h1>
      <% if @num_sites_left > 0 %>
        <a href="/admin/sites/new" class="btn btn-primary">Create a new site</a>
      <% else %>
        <button
        type="button"
        class="site-limit-tooltip btn btn-primary"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="You've reached your account's site limit"
      >
          Add new site
        </button>
      <% end %>
    </div>
    <div class="overflow-x-auto">
      <div class="min-w-screen font-sans overflow-hidden">
        <div class="w-full">
          <div class="bg-white shadow-md rounded my-6 table-responsive">
            <%= turbo_frame_tag "site_files", src: "/admin/sites/all", target:
            "_top" do %> <%= render partial: "admin/sites/all_sites_loading" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div
  class="modal fade"
  id="deleteSiteModal"
  tabindex="-1"
  aria-labelledby="deleteSiteLabel"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="deleteSiteLabel">Delete site</h1>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <form
          id="delete-site-form"
          action="/admin/sites/delete"
          method="DELETE"
          data-turbo="true"
        >
          Are you sure you want to delete
          <strong
            ><span id="deleting-site-name-for-modal"></span
            >.maysengreenwood.com</strong
          >?
          <br />
          <br />
          This action is irreversible
          <input type="hidden" value="" name="site_name" id="site_name" />
        </form>
      </div>
      <div data-controller="site" class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="submit" form="delete-site-form" class="btn btn-danger">
          <span
            class="d-none spinner-border spinner-border-sm"
            role="status"
            aria-hidden="true"
          ></span>
          Delete site
        </button>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    $("button.site-limit-tooltip").tooltip();
  });

  document.addEventListener("turbo:before-fetch-response", function (e) {
    const allModals = document.querySelectorAll(".modal");

    allModals.forEach((modal) => {
      let modalInstanceDismissBtn = modal.querySelector("[data-bs-dismiss]");
      if (modalInstanceDismissBtn) {
        modalInstanceDismissBtn.click();
      }
    });
  });
</script>
