<div class="container">
  <div class="container mt-3">
    <div class="d-flex justify-content-between mb-3 align-items-center">
      <h1>All sites</h1>
      <a href="/admin/sites/new" class="btn btn-primary">Create a new site</a>
    </div>
    <table class="table table-hover" style="border: 1px solid black;">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col"></th>
          <th scope="col">Site size</th>
          <th scope="col">Requests</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody data-controller="site">
        <% @sites.each do |site| %>
          <tr data-site-id="<%= site["id"] %>" data-site-name="<%= site["name"] %>">
            <td colspan="2">
              <svg width="54" height="54" class="space-icon-window OPEN" viewBox="0 0 32 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M26.25 2.75H3.75C2.71447 2.75 1.875 3.58947 1.875 4.625V8.375H28.125V4.625C28.125 3.58947 27.2855 2.75 26.25 2.75ZM1.875 23.375V10.25H28.125V19.0015C28.7904 19.0179 29.4235 19.1642 30 19.416V4.625C30 2.55393 28.3211 0.875 26.25 0.875H3.75C1.67893 0.875 0 2.55393 0 4.625V23.375C0 25.4461 1.67893 27.125 3.75 27.125H24.0966C23.6609 26.5815 23.3364 25.945 23.1575 25.25H3.75C2.71447 25.25 1.875 24.4105 1.875 23.375ZM4.6875 6.5C5.20527 6.5 5.625 6.08027 5.625 5.5625C5.625 5.04473 5.20527 4.625 4.6875 4.625C4.16973 4.625 3.75 5.04473 3.75 5.5625C3.75 6.08027 4.16973 6.5 4.6875 6.5ZM8.4375 5.5625C8.4375 6.08027 8.01777 6.5 7.5 6.5C6.98223 6.5 6.5625 6.08027 6.5625 5.5625C6.5625 5.04473 6.98223 4.625 7.5 4.625C8.01777 4.625 8.4375 5.04473 8.4375 5.5625ZM10.3125 6.5C10.8303 6.5 11.25 6.08027 11.25 5.5625C11.25 5.04473 10.8303 4.625 10.3125 4.625C9.79473 4.625 9.375 5.04473 9.375 5.5625C9.375 6.08027 9.79473 6.5 10.3125 6.5Z" fill="#282A35"></path>
                <circle class="dot" cx="28" cy="24" r="4"></circle>
                <defs>
                  <clipPath id="clip0">
                    <rect width="8.75" height="10" fill="white" transform="translate(11 12)"></rect>
                </defs>
              </svg>
              <a href="/admin/sites/<%= site["name"] %>">https://<%= site["name"] %>.maysengreenwood.com</a>
            </td>
            <td><span>
            <% if site["total_size"] > 1000 %>
              <%= site["total_size"].to_i / 1000 %> kb
            <% else %>
              <%= site["total_size"] %> b
            <% end %>
            </span></td>
            <td>-</td>
            <td>
              <button data-action="site#openDeleteSiteModal" data-site-id="<%= site["id"] %>" data-site-name="<%= site["name"] %>" type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteSiteModal">Delete site</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="modal fade" id="deleteSiteModal" tabindex="-1" aria-labelledby="deleteSiteLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="deleteSiteLabel">Delete site</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            Are you sure you want to delete <strong><span id="deleting-site-name-for-modal"></span>.maysengreenwood.com</strong>? 
            <br/>
            <br/>
            This action is irreversible
            <input type="hidden" value="" name="site_name" id="site_name">
          </div>
          <div data-controller="site" class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button data-action="site#deleteSite" type="button" class="btn btn-danger">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Delete site
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>