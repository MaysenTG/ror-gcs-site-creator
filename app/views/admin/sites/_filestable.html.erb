<div id="site-files-for-<%= folder[:name] %>" class="d-none files-table overflow-x-auto">
      <div class="min-w-screen font-sans overflow-hidden">
        <div class="w-full">
          <div class="bg-white shadow-md rounded my-6">
            <table class="min-w-max w-full table-auto">
              <thead>
                <tr class="bg-gray-200 text-gray-600 uppercase text-sm leading-normal">
                  <th class="py-3 px-6 text-left">Filename</th>
                  <th class="py-3 px-6 text-left">Size</th>
                  <th class="py-3 px-6 text-center">Actions</th>
                </tr>
              </thead>
              <tbody class="text-gray-600 text-sm font-light">
              <% if folder[:files].length == 0 %>
                <tr class="border-b border-gray-200 hover:bg-gray-100">
                  <td colspan="4" class="py-3 px-6 text-left whitespace-nowrap">
                    No files in this folder
                  </td>
                </tr>
              <% else %>
                <% folder[:files].each do |file| %>
                  <% file = file.as_json %>
                  <tr data-controller="folder" data-file-name="<%= folder[:name] %>/<%= file["name"] %>" class="border-b border-gray-200 hover:bg-gray-100">
                    <td class="py-3 px-6 text-left whitespace-nowrap">
                      <a <% if file["type"] == "file" %>href="/admin/sites/<%= @site.name %>/files/edit?file_name=<%= folder[:name] %>/<%= file["name"] %>"<% else %>data-action="folder#viewFolderFiles" data-folder-name="<%= file["name"] %>"<% end %> class="<% if file["type"] == "folder" %>div-folder-target<% end %> flex items-center">
                        <div class="mr-2">
                          
                        <!-- Begin file logo -->
                        <% if file["type"] == "file" %>
                          <% unless file["name"].nil? %>
                            <% if file["name"].include?(".css") %>
                              <i class="fs-3 bi bi-filetype-css"></i>
                            <% elsif file["name"].include?(".js") %>
                              <i class="fs-3 bi bi-filetype-js"></i>
                            <% elsif file["name"].include?(".html") %>
                              <i class="fs-3 bi bi-filetype-html"></i>
                            <% else %>
                              <i class="fs-3 bi bi-file-code"></i>
                            <% end %>
                          <% end %>
                        <% elsif file["type"] == "folder" %>
                          <i class="fs-3 bi bi-folder-fill"></i>
                        <% end %>
                        <!-- End file logo -->
                          
                        </div>
                        <span class="font-medium"><%= file["name"] %></span>
                      </a>
                    </td>
                    <td class="py-3 px-6 text-left">
                      <div class="flex items-center">
                        <span>
                        <% if file["type"] == "file" %>
                          <% if file["size"] > 1000 %>
                            <%= file["size"].to_i / 1000 %> kb
                          <% else %>
                            <%= file["size"] %> b
                          <% end %>
                        <% else %>
                          -
                        <% end %>
                        </span>
                      </div>
                    </td>
                    <td class="py-3 px-6 text-center">
                      <div data-controller="file" class="flex item-center justify-center">
                      
                        <!-- Edit file -->
                        <% if file["type"] == "file" %>
                          <div data-action="click->file#openRenameFileModal" data-bs-target="#renameFileModal" data-bs-toggle="modal" data-file-name="<%= file["name"] %>" class="div-edit-toggle w-4 mr-2 transform hover:text-purple-500 hover:scale-110">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                            </svg>
                          </div>
                        <% end %>
                        <!-- Delete file -->
                        <% unless file["name"].include?("index") %>
                          <div data-action="click->file#openDeleteFileModal" class="w-4 mr-2 transform hover:text-purple-500 hover:scale-110" data-file-name="WOW" data-action="file#openDeleteFileModal" data-bs-target="#deleteFileModal" data-bs-toggle="modal">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </div>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>