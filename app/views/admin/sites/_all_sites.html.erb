<%# Used as the partial for all account's sites %>
<% account_plan = Plan.where(plan_handle: current_account.plan_handle).first %>

<table class="table align-middle table-hover">
  <thead class="table-secondary">
    <tr>
      <th scope="col" class="p-3">Name</th>
      <th scope="col" class="p-3">Total size</th>
      <th scope="col" class="text-center p-3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if @sites.length == 0 %>
      <tr>
        <td colspan="3" class="py-3 px-6 text-center">
          <span class="font-medium">You don't have any sites yet.</span>
          <span class="text-gray-600"><a href="/admin/sites/new">Create a new site to get started.</a></span>
        </td>
      </tr>
    <% else %>
      <% @sites.each do |site| %>
        <tr data-site-id="<%= site["id"] %>" data-site-name="<%= site["name"] %>" class="border-b border-gray-200 hover:bg-gray-100">
          <td class="py-3 px-6 text-left whitespace-nowrap">
            <a href="/admin/sites/<%= site.name %>?filename=index.html" class="d-flex align-items-center p-3">
              <div class="mr-2">
                <svg width="54" height="54" class="space-icon-window OPEN" viewBox="0 0 32 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M26.25 2.75H3.75C2.71447 2.75 1.875 3.58947 1.875 4.625V8.375H28.125V4.625C28.125 3.58947 27.2855 2.75 26.25 2.75ZM1.875 23.375V10.25H28.125V19.0015C28.7904 19.0179 29.4235 19.1642 30 19.416V4.625C30 2.55393 28.3211 0.875 26.25 0.875H3.75C1.67893 0.875 0 2.55393 0 4.625V23.375C0 25.4461 1.67893 27.125 3.75 27.125H24.0966C23.6609 26.5815 23.3364 25.945 23.1575 25.25H3.75C2.71447 25.25 1.875 24.4105 1.875 23.375ZM4.6875 6.5C5.20527 6.5 5.625 6.08027 5.625 5.5625C5.625 5.04473 5.20527 4.625 4.6875 4.625C4.16973 4.625 3.75 5.04473 3.75 5.5625C3.75 6.08027 4.16973 6.5 4.6875 6.5ZM8.4375 5.5625C8.4375 6.08027 8.01777 6.5 7.5 6.5C6.98223 6.5 6.5625 6.08027 6.5625 5.5625C6.5625 5.04473 6.98223 4.625 7.5 4.625C8.01777 4.625 8.4375 5.04473 8.4375 5.5625ZM10.3125 6.5C10.8303 6.5 11.25 6.08027 11.25 5.5625C11.25 5.04473 10.8303 4.625 10.3125 4.625C9.79473 4.625 9.375 5.04473 9.375 5.5625C9.375 6.08027 9.79473 6.5 10.3125 6.5Z" fill="#282A35"></path>
                  <circle class="dot" cx="28" cy="24" r="4"></circle>
                  <defs>
                    <clipPath id="clip0">
                      <rect width="8.75" height="10" fill="white" transform="translate(11 12)"></rect>
                    </clipPath>
                  </defs>
                </svg>
              </div>
              <span class="font-medium">
                https://<%= site.name %>.maysengreenwood.com
              </span>
            </a>
          </td>
          <td class="py-3 px-6 text-left">
            <div class="d-flex align-items-start flex-column w-50">
              <span>
                <% site_total_size = @size_per_site[site.name] %>
                <% if site_total_size > 1000 %>
                  <%= site_total_size.to_i / 1000 %> kb
                <% else %>
                  <%= site_total_size %> b
                <% end %>
                / <%= account_plan.max_site_size %> mb
                <% progress_percent = (site["total_size"].to_f / (account_plan.max_site_size.to_f * 1000000)) * 100.0 %>
              </span>
              <% if progress_percent < 60 %>
                <% progress_class = "progress-bar bg-success" %>
              <% elsif progress_percent > 60 and progress_percent < 90 %>
                <% progress_class = "progress-bar bg-warning" %>
              <% else %>
                <% progress_class = "progress-bar bg-danger" %>
              <% end %>
              <div class="progress w-100 border border-dark">
                <div class="<%= progress_class %>" role="progressbar" style="width: <%= progress_percent.to_i %>%;" aria-valuenow="<%= progress_percent.to_i %>" aria-valuemin="0" aria-valuemax="100"><%= progress_percent.to_i %>%</div>
              </div>
            </div>
          </td>
          <td class="py-3 px-6 text-center">
            <div data-controller="site" class="d-flex align-item-center justify-content-center">
              <!-- Delete file -->
              <div data-action="click->site#openDeleteSiteModal" class="fs-5" data-bs-target="#deleteSiteModal" data-bs-toggle="modal">
                <i class="bi bi-trash3"></i>
              </div>
            </div>
          </td>
        </tr>
      <% end %>
      <!-- Write an empty table row with a button and a plus button to add a new site -->
      <% if @num_sites_left > 0 %>
        <tr>
          <td colspan="4" class="p-3 text-left whitespace-nowrap">
            <a href="/admin/sites/new" class="d-flex align-items-center justify-content-center p-3">
              <div class="fs-3 mr-2">
                <i class="bi bi-plus-square-dotted"></i>
              </div>
              Add a new site (<%= @num_sites_left %> remaining)
            </a>
          </td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>