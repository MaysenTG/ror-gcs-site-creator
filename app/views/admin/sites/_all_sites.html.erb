<% account_plan = @account_plan || current_account.current_plan %>

<% if @sites.blank? %>
  <div class="empty-state">
    <h2>No sites yet</h2>
    <p>Create your first static site and edit it right in the browser.</p>
    <a href="/admin/sites/new" class="btn btn-primary">Create a site</a>
  </div>
<% else %>
  <div class="site-card-grid">
    <% @sites.each do |site| %>
      <% site_total_size = @size_per_site[site.name].to_i %>
      <% max_bytes = account_plan.max_site_size.to_f * 1_000_000 %>
      <% progress_percent = max_bytes.positive? ? ((site_total_size / max_bytes) * 100.0).clamp(0, 100) : 0 %>
      <% progress_class =
           if progress_percent < 60 then "bg-success"
           elsif progress_percent < 90 then "bg-warning"
           else "bg-danger"
           end %>
      <article class="site-card" data-controller="site" data-site-id="<%= site.id %>" data-site-name="<%= site.name %>">
        <div class="site-card__top">
          <div>
            <h2 class="site-card__title"><%= site.name %></h2>
            <a class="site-card__url" href="<%= site_preview_url(site) %>" target="_blank" rel="noopener">
              <%= site_preview_label(site) %>
            </a>
          </div>
          <div class="site-card__actions">
            <button type="button" class="btn btn-ghost btn-sm" data-action="click->site#openDeleteSiteModal" data-bs-target="#deleteSiteModal" data-bs-toggle="modal" aria-label="Delete site">
              <i class="bi bi-trash3"></i>
            </button>
          </div>
        </div>

        <div class="site-card__meta">
          <span>
            <% if site_total_size > 1000 %>
              <%= site_total_size / 1000 %> KB
            <% else %>
              <%= site_total_size %> B
            <% end %>
            / <%= account_plan.max_site_size %> MB
          </span>
          <span><%= progress_percent.to_i %>%</span>
        </div>
        <div class="progress">
          <div class="progress-bar <%= progress_class %>" role="progressbar" style="width: <%= progress_percent.to_i %>%;" aria-valuenow="<%= progress_percent.to_i %>" aria-valuemin="0" aria-valuemax="100"></div>
        </div>

        <div class="site-card__footer">
          <a href="/admin/sites/<%= site.name %>?filename=index.html" class="btn btn-primary btn-sm">Edit</a>
          <a href="/admin/sites/<%= site.name %>/dashboards" class="btn btn-ghost btn-sm">Dashboard</a>
          <button
            type="button"
            class="btn btn-ghost btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#cloneSiteModal"
            data-site-name="<%= site.name %>"
            data-action="click->site#openCloneSiteModal"
          >
            Clone
          </button>
          <a href="<%= site_preview_url(site) %>" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">Preview</a>
        </div>
      </article>
    <% end %>

    <% if @num_sites_left.to_i > 0 %>
      <a href="/admin/sites/new" class="site-card site-card--add">
        <i class="bi bi-plus-lg"></i>
        <strong>Add a new site</strong>
        <span><%= @num_sites_left %> remaining on your plan</span>
      </a>
    <% end %>
  </div>
<% end %>
