<%= javascript_tag do %>
  window.all_files_and_folders = <%= raw @site_files_and_folders.to_json %>
<% end %>

<div data-controller="general" class="container">
  <div class="container mt-3">
    <a href="/admin/sites" class="mb-3 btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to sites</a>
    <div class="mb-3 d-flex justify-content-start">
      &nbsp;
      <div class="w-100 d-flex justify-content-between flex-wrap align-items-center">
        <h1>Files</h1>
      </div>
    </div>
    <div class="mb-3 d-flex justify-content-start">
      &nbsp;
      <div class="w-100 d-flex justify-content-between flex-wrap">
        <div class="row d-flex align-items-center">
          <div class="col-2">
            <svg width="54" height="54" class="space-icon-window OPEN" viewBox="0 0 32 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M26.25 2.75H3.75C2.71447 2.75 1.875 3.58947 1.875 4.625V8.375H28.125V4.625C28.125 3.58947 27.2855 2.75 26.25 2.75ZM1.875 23.375V10.25H28.125V19.0015C28.7904 19.0179 29.4235 19.1642 30 19.416V4.625C30 2.55393 28.3211 0.875 26.25 0.875H3.75C1.67893 0.875 0 2.55393 0 4.625V23.375C0 25.4461 1.67893 27.125 3.75 27.125H24.0966C23.6609 26.5815 23.3364 25.945 23.1575 25.25H3.75C2.71447 25.25 1.875 24.4105 1.875 23.375ZM4.6875 6.5C5.20527 6.5 5.625 6.08027 5.625 5.5625C5.625 5.04473 5.20527 4.625 4.6875 4.625C4.16973 4.625 3.75 5.04473 3.75 5.5625C3.75 6.08027 4.16973 6.5 4.6875 6.5ZM8.4375 5.5625C8.4375 6.08027 8.01777 6.5 7.5 6.5C6.98223 6.5 6.5625 6.08027 6.5625 5.5625C6.5625 5.04473 6.98223 4.625 7.5 4.625C8.01777 4.625 8.4375 5.04473 8.4375 5.5625ZM10.3125 6.5C10.8303 6.5 11.25 6.08027 11.25 5.5625C11.25 5.04473 10.8303 4.625 10.3125 4.625C9.79473 4.625 9.375 5.04473 9.375 5.5625C9.375 6.08027 9.79473 6.5 10.3125 6.5Z" fill="#282A35"></path>
              <circle class="dot" cx="28" cy="24" r="4"></circle>
              <defs>
                <clipPath id="clip0">
                  <rect width="8.75" height="10" fill="white" transform="translate(11 12)"></rect>
                </clipPath>
              </defs>
            </svg>
          </div>
          <div class="col-10">
            <h3><%= @site.name %></h3>
            <a target="_blank" href="https://<%= @site.name %>.maysengreenwood.com">
              <h3><%= @site.name %>.maysengreenwood.com</h3>
            </a>
          </div>
        </div>
        <div class="dropdown">
          <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">New file/folder</button>
          <ul class="dropdown-menu">
            <li><button type="button" class="btn btn-primary dropdown-item" data-bs-toggle="modal" data-bs-target="#createFileModal">Create a new file</button></li>
            <li><button type="button" class="btn btn-primary dropdown-item" data-bs-toggle="modal" data-bs-target="#createFolderModal">Create a new folder</button></li>
            <li><button type="button" class="btn btn-primary dropdown-item" data-bs-toggle="modal" data-bs-target="#uploadFileModal">Upload a file</button></li>
          </ul>
        </div>
      </div>
    </div>
    <nav class="mb-3" aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item active" aria-current="page">Root folder</li>
      </ol>
    </nav>
    
    <div data-controller="folder">
      <a id="toggle-back-to-root-folder" href="#" class="d-none" data-action="folder#viewRootFolder">
        <i class="bi bi-arrow-left"></i>
        Back to root folder
      </a>
    </div>
    
    <table id="site-files" class="files-table table table-hover" style="border: 1px solid black;">
      <thead>
        <tr>
          <th scope="col">Filename</th>
          <th scope="col">Size</th>
          <th scope="col">Copy URL</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @site_files_and_folders.each do |file| %>
          <tr data-controller="folder" data-file="<%= file["name"] %>">
            <th scope="row">
            
            <!-- If the file name ends with "/" -->
            
            <% if file["type"] == "file" %>
              <a href="/admin/sites/<%= @site.name %>/files/edit?file_name=<%= file["name"] %>"><%= file["name"] %></a>
            <% else %>
              <i class="bi bi-folder-fill"></i>
              <a href="#" data-action="folder#viewFolderFiles" data-folder-name="<%= file["name"] %>"><%= file["name"] %></a>
            <% end %>
            
            <% if file["is_main"] %>
              <i class="bi bi-star-fill"></i>
            <% end %>
            </th>
            <td>
            <% if file["type"] == "file" %>
              <% if file["size"] > 1000 %>
                <%= file["size"].to_i / 1000 %> kb
              <% else %>
                <%= file["size"] %> b
              <% end %>
            <% end %>
            </td>
            <td><button class="btn" type="button"><i data-file-name="<%= file["name"] %>" class="bi bi-clipboard"></i></button></td>
            <td>
              <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Actions</button>
                
                <ul class="dropdown-menu" data-controller="file">
                  <% if file["type"] == "file" %>
                    <li>
                      <a class="dropdown-item" href="#" data-action="file#openRenameFileModal" data-bs-target="#renameFileModal" data-bs-toggle="modal" data-file-name="<%= file["name"] %>">Rename file</a>
                    </li>
                  <% end %>
                  <li>
                    <button data-file-name="<%= file["name"] %>" data-action="file#openDeleteFileModal" data-bs-target="#deleteFileModal" data-bs-toggle="modal" class="btn btn-danger dropdown-item" type="button">Delete</button>
                  </li>
                </ul>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    
    <% @folders_with_files.each do |folder| %>
      <%# <table id="site-folder-files-" class="table table-hover" style="border: 1px solid black;"> %>
      <table id="site-files-for-<%= folder[:name] %>" class="d-none files-table table table-hover" style="border: 1px solid black;">
      <thead>
        <tr>
          <th scope="col">Filename</th>
          <th scope="col">Size</th>
          <th scope="col">Copy URL</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
      <% if folder[:files].length == 0 %>
        <tr>
          <td colspan="4">This folder is empty.</td>
        </tr>
      <% end %>
      <% folder[:files].each do |file| %>
      <% file = file.as_json %>
          <tr data-controller="folder" data-file="<%= file["name"] %>">
            <th scope="row">
            
            <!-- If the file name ends with "/" -->
            
            <a href="/admin/sites/<%= @site.name %>/files/edit?file_name=<%= folder[:name] %>/<%= file["name"] %>"><%= file["name"] %></a>
            
            <% if file["is_main"] %>
              <i class="bi bi-star-fill"></i>
            <% end %>
            </th>
            <td>
            <% if file["type"] == "file" %>
              <% if file["size"] > 1000 %>
                <%= file["size"].to_i / 1000 %> kb
              <% else %>
                <%= file["size"] %> b
              <% end %>
            <% end %>
            </td>
            <td><button class="btn" type="button"><i data-file-name="<%= file["name"] %>" class="bi bi-clipboard"></i></button></td>
            <td>
              <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Actions</button>
                
                <ul class="dropdown-menu" data-controller="file">
                  <% if file["type"] == "file" %>
                    <li>
                      <a class="dropdown-item" href="#" data-action="file#openRenameFileModal" data-bs-target="#renameFileModal" data-bs-toggle="modal" data-folder-name="<%= folder[:name] %>" data-file-name="<%= file["name"] %>">Rename file</a>
                    </li>
                  <% end %>
                  <li>
                    <button data-file-name="<%= folder[:name] %>/<%= file["name"] %>" data-folder-name="<%= folder[:name] %>" data-action="file#openDeleteFileModal" data-bs-target="#deleteFileModal" data-bs-toggle="modal" class="btn btn-danger dropdown-item" type="button">Delete</button>
                  </li>
                </ul>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% end %>
    
    <div class="modal fade" id="createFileModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Create a new file </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form action="/admin/sites/<%= @site["name"] %>/files/new" id="create-file-form">
                  <input type="hidden" name="site_id" value="1">
                  <input type="hidden" name="site_name" id="site_name" value="<%= @site["name"] %>">
                  <div data-controller="validation" class="mb-3">
                    <label for="name" class="form-label">File name</label>
                    <input data-action="input->validation#validate" type="text" class="form-control" id="name" name="file_name">
                  </div>
                  <div class="mb-3">
                    <label for="name" class="form-label">File type</label>
                    <select class="form-select" aria-label="Default select example" name="file_type">
                      <option value="html" selected="">HTML</option>
                      <option value="js">JS</option>
                      <option value="css">CSS</option>
                    </select>
                  </div>
                  <%# <select class="form-select" aria-label="Default select example" name="main_or_404">
                    <option value="none">Set file type</option>
                    <option value="set_as_main">Set as main page</option>
                    <option value="set_as_404">Set as the 404 page</option>
                  </select> %>
                </form>
              </div>
            </div>
          </div>
          <div data-controller="file" class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button data-action="file#createFile" type="button" form="create-file-form" disabled="" class="btn btn-primary">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Create file
            </button>
          </div>
        </div>
      </div>
    </div>
    <div data-controller="folder" class="modal fade" id="createFolderModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Create a new folder</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form id="create-folder-form">
                  <input type="hidden" name="site_id" value="<%= @site["id"] %>">
                  <input type="hidden" name="site_name" value="<%= @site["name"] %>">
                  <div class="mb-3">
                    <label for="name" class="form-label">Folder name</label>
                    <input data-action="input->folder#validateFolderName" type="text" class="form-control" id="name" name="folder_name">
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" data-action="folder#createFolder" disabled="" form="create-folder-form" class="btn btn-primary">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Create folder
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="renameFileModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Rename file</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form id="rename-file-form">
                  <input type="hidden" name="site_id" value="<%= @site["id"] %>">
                  <input type="hidden" name="site_name" value="<%= @site["name"] %>">
                  <input type="hidden" name="current_file_name" id="current_file_name" value="">
                  <input type="hidden" name="folder_name" id="folder_name" value="">
                  <div data-controller="validation" class="mb-3">
                    <label for="name" class="form-label">New file name</label>
                    <input type="text" data-action="input->validation#validateAllowFileType" class="form-control" id="new_file_name" name="new_file_name" value="">
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div data-controller="file" class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" data-action="file#renameFile" form="rename-file-form" class="btn btn-primary">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Rename file
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="uploadFileModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Upload a new file </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form id="upload-file-form">
                  <input type="hidden" name="site_id" value="<%= @site["id"] %>">
                  <input type="hidden" name="site_name" value="<%= @site["name"] %>">
                  <div data-controller="validation" class="mb-3">
                    <label for="formFile" class="form-label">Upload a file</label>
                    <input data-action="validation#fileHasBeenSelectedForUpload" class="form-control" type="file" name="file" id="formFile">
                  </div>
                </form>
                <small><strong>Note: </strong>This file will overwrite any file with the same name</small>
              </div>
            </div>
          </div>
          <div data-controller="file" class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" data-action="file#uploadFile" form="upload-file-form" disabled="" class="btn btn-primary">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Upload file
            </button>
          </div>
        </div>
      </div>
    </div>
    <div class="modal fade" id="deleteFileModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Delete file </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form id="delete-file-form">
                  <input type="hidden" name="site_id" value="<%= @site["id"] %>">
                  <input type="hidden" name="site_name" value="<%= @site["name"] %>">
                  <input type="hidden" name="file_name" id="file_name" value="">
                  <input type="hidden" name="folder_name" id="folder_name" value="">
                </form>
              </div>
            </div>
            Are you sure you want to delete this file? This action cannot be undone.
          </div>
          <div data-controller="file" class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" data-action="file#deleteFile" form="delete-file-form" class="btn btn-danger">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Delete file
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>