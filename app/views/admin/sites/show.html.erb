<style>
  .accordion-body:not(.accordion-active):hover {
    background-color: #f7f7f7;
  }

  .accordion-body.add-new-file:hover {
    background-color: #f7f7f7;
  }

  .accordion-active.accordion-body {
    background: #e6e6e6;
  }

  .files-icons-container {
    display: block;
  }

  .accordion-body:not(.accordion-active) .file-icons-container {
    display: none !important;
  }
</style>
<div data-controller="general" class="container">
  <div class="container mt-3">
    <div class="mb-3 d-flex justify-content-between">
      <a href="/admin/sites" class="mb-3 btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to sites</a>
      <a href="/admin/sites/<%= @site.name %>/domains" class="mb-3 btn btn-secondary">Domains</a>
    </div>
    <!-- Begin general -->
    <div class="mb-3 d-flex justify-content-start">
      &nbsp;
      <div class="w-100 d-flex justify-content-between flex-wrap">
        <div class="row d-flex align-items-center">
          <div class="col-2">
            <svg width="54" height="54" class="space-icon-window OPEN" viewBox="0 0 32 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M26.25 2.75H3.75C2.71447 2.75 1.875 3.58947 1.875 4.625V8.375H28.125V4.625C28.125 3.58947 27.2855 2.75 26.25 2.75ZM1.875 23.375V10.25H28.125V19.0015C28.7904 19.0179 29.4235 19.1642 30 19.416V4.625C30 2.55393 28.3211 0.875 26.25 0.875H3.75C1.67893 0.875 0 2.55393 0 4.625V23.375C0 25.4461 1.67893 27.125 3.75 27.125H24.0966C23.6609 26.5815 23.3364 25.945 23.1575 25.25H3.75C2.71447 25.25 1.875 24.4105 1.875 23.375ZM4.6875 6.5C5.20527 6.5 5.625 6.08027 5.625 5.5625C5.625 5.04473 5.20527 4.625 4.6875 4.625C4.16973 4.625 3.75 5.04473 3.75 5.5625C3.75 6.08027 4.16973 6.5 4.6875 6.5ZM8.4375 5.5625C8.4375 6.08027 8.01777 6.5 7.5 6.5C6.98223 6.5 6.5625 6.08027 6.5625 5.5625C6.5625 5.04473 6.98223 4.625 7.5 4.625C8.01777 4.625 8.4375 5.04473 8.4375 5.5625ZM10.3125 6.5C10.8303 6.5 11.25 6.08027 11.25 5.5625C11.25 5.04473 10.8303 4.625 10.3125 4.625C9.79473 4.625 9.375 5.04473 9.375 5.5625C9.375 6.08027 9.79473 6.5 10.3125 6.5Z" fill="#282A35"></path>
              <circle class="dot" cx="28" cy="24" r="4"></circle>
              <defs>
                <clipPath id="clip0">
                  <rect width="8.75" height="10" fill="white" transform="translate(11 12)"></rect>
                </clipPath>
              </defs>
            </svg>
          </div>
          <div class="col-10">
            <h3 class="h3 mb-0"><%= @site.name %></h3>
            <a target="_blank" href="https://<%= @site.name %>.maysengreenwood.com">
              <%= @site.name %>.maysengreenwood.com
            </a>
          </div>
        </div>
        <div class="dropdown">
          <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadFileModal">Upload a file</button>
        </div>
      </div>
    </div>
    <div class="row">
      <!-- Add the warning alert here -->
      <%= turbo_frame_tag "file_delete_error" do %>
      <% end %>
      <div class="col-12 col-lg-3 col-md-12 col-sm-12" style="margin: 5rem 0;">
        <turbo-frame id="filepicker">
          <%= render partial: "admin/files/filepicker", @site => @site, @site_files_and_folders => @site_files_and_folders %>
        </turbo-frame>
      </div>
      <div class="col-12 col-9 col-lg-9 col-md-12 col-sm-12">
        <!-- Create a turbo frame tag for the editor partial -->
        <%= turbo_frame_tag "editor" do %>
        <% end %>
      </div>
    </div>
    <br>
    <div class="modal fade" id="createFileModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="exampleModalLabel">Create a new file </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="container">
              <div class="mb-3">
                <form action="/admin/sites/<%= @site["name"] %>/files/new" method="post" data-turbo="true" id="create-file-form">
                  <input type="hidden" name="site_id" value="1">
                  <input type="hidden" name="site_name" id="site_name" value="<%= @site["name"] %>">
                  <input type="hidden" name="folder_name" id="folder_name" value="">
                  <div data-controller="file validation" class="mb-3">
                    <label for="name" class="form-label">File name</label>
                    <input data-action="validation#validate file#setFullFileName" type="text" class="form-control" id="visual_filename" >
                    <input type="hidden" name="file_name" >
                  </div>
                  <div class="mb-3">
                    <label for="name" class="form-label">File type</label>
                    <select class="form-select" aria-label="Default select example" name="file_type" id="file_type">
                      <option value="html" selected="">HTML</option>
                      <option value="js">JS</option>
                      <option value="css">CSS</option>
                    </select>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div data-controller="file" class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" form="create-file-form" disabled="" class="btn btn-primary">
              <span class="d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
              Create file
            </button>
          </div>
        </div>
      </div>
    </div>
    <%= render :partial => "layouts/modals/sites/show/createfolder", :locals => { :site => @site } %>
    <%= render :partial => "layouts/modals/sites/show/renamefile", :locals => { :site => @site } %>
    <%= render :partial => "layouts/modals/sites/show/uploadfile", :locals => { :site => @site } %>
    <%= render :partial => "layouts/modals/sites/show/deletefile", :locals => { :site => @site } %>
    <%= render :partial => "layouts/modals/sites/show/mainor404", :locals => { :site => @site } %>
  </div>
</div>
<!-- Toast when saving file -->
<div id="file_saved">File saved..</div>
<div id="file_404">File doesn't exist..</div>
<!-- Scroll to top button -->
<button onclick="topFunction()" id="scrollToTop" title="Go to top">
  <i class="bi bi-arrow-up"></i>
</button>
<script>
  document.addEventListener("turbo:before-fetch-response", function(e) {
    waitForElm('#file_content').then((elm) => {
      let fileName = elm.dataset.filename;
      let fileExtension = fileName.split('.').pop();
      let mode = "htmlmixed";
      if (fileExtension == "js") {
        mode = "text/javascript";
      } else if (fileExtension == "css") {
        mode = "text/css";
      }

      const fileContentTextArea = document.getElementById("file_content");
      let fileContentTextAreaHasCodemirror = fileContentTextArea.parentElement.querySelector(".CodeMirror")

      if (!fileContentTextAreaHasCodemirror) {
        let editor = CodeMirror.fromTextArea(fileContentTextArea, {
          mode: mode,
          lineNumbers: true,
          autoCloseTags: true,
          autoCloseBrackets: true,
          matchBrackets: true,
          foldGutter: true,
          //gutters: ["CodeMirror-linenumbers", "CodeMirror-foldgutter"],
          styleActiveLine: true,
          indentUnit: 2,
          indentWithTabs: false,
          tabSize: 2,
          extraKeys: {
            "Ctrl-Space": "autocomplete",
            "Cmd-S": function (instance) {
              document.querySelector("#save-file-btn").click();
            },
          },
        });
        editor.on("change", function(cm, change) {
          document.getElementById("file_content").value = cm.getValue();
          // Enable save button
          document.querySelector("#save-file-btn").disabled = false;
        });
      }

      // Hide the loading spinner
      document.querySelector("#save-file-btn").querySelector("span").classList.add("d-none");
      document.querySelector("#save-file-btn").querySelector(".save-btn-text-loading").classList.add("d-none");
      document.querySelector("#save-file-btn").querySelector(".save-btn-text").classList.remove("d-none");
    });

    const allModals = document.querySelectorAll(".modal");

    allModals.forEach((modal) => {
      let modalInstanceDismissBtn = modal.querySelector("[data-bs-dismiss]");
      if (modalInstanceDismissBtn) {
        modalInstanceDismissBtn.click();
      }
    });

    if(e.detail.fetchResponse.response.url.includes("/files/update") && !e.detail.fetchResponse.response.headers.get("site-over-limit")) {
      let fileTooBigError = document.querySelector(".file__too__big__error");
      if(fileTooBigError) {
        fileTooBigError.classList.add("d-none");
      }
      showToast("file_saved");
      // Disable save button
      let saveBtn = document.querySelector("#save-file-btn");
      saveBtn && saveBtn.classList.add("disabled");
    }

    if(e.detail.fetchResponse.response.url.includes("/files/upload")) {
      waitForElm(`a[data-filename="${e.detail.fetchResponse.response.headers.get("file-name")}"]`).then((elm) => {
        elm.click();
      });
    }

    if(e.detail.fetchResponse.response.headers.get("site-over-limit")) {
      document.querySelector(".file__too__big__error").classList.remove("d-none");
    }

    try {
      let eventType = event.detail.fetchResponse.response.headers.get("action-type")
      if (eventType == "rename") {
        // Click the file link to reload the file
        waitForElm(`a[data-filename="${event.detail.fetchResponse.response.headers.get("new-file-name")}"]`).then((elm) => {
          elm.click();
        });
      } else if(eventType == "delete") {
        // remove the file from the URL
        // and delete the inner contents of the editor tag
        let url = new URL(window.location.href);
        url.searchParams.delete("filename");
        window.history.pushState({}, "", url);
        document.getElementById("editor").innerHTML = "";
      }
    } catch (error) {
      console.log(error);
    }
  });
</script>
<script>
  // When the CMD+S key is pressed, save the file
  document.addEventListener("keydown", function(e) {
    if (e.key == "s" && (navigator.platform.match("Mac") ? e.metaKey : e.ctrlKey)) {
      e.preventDefault();
      document.querySelector("#save-file-btn").click();
    }
  });

  document.addEventListener("turbo:before-fetch-request", function(e) {
    if(!e.detail.url.href.includes("/files/update") && !e.detail.url.href.includes("/files/delete")) {
      // Make the code editor appear like it's loading
      waitForElm("#editor").then((elm) => {
        elm.innerHTML = `<%= render :partial => "layouts/snippets/code_loading" %>`;
      });
    } else {
      document.querySelector("#save-file-btn").querySelector("span").classList.remove("d-none");
      document.querySelector("#save-file-btn").querySelector(".save-btn-text-loading").classList.remove("d-none");
      document.querySelector("#save-file-btn").querySelector(".save-btn-text").classList.add("d-none");

    }
  })

  document.addEventListener("turbo:load", function() {
    addEventListenerToFileLinks();

    // Get the filename from the URL using the URLSearchParams API
    const urlParams = new URLSearchParams(window.location.search);
    const filename = urlParams.get("filename");

    if (filename) {
      const fileLink = document.querySelector(`a[data-filename="${filename}"]`);
      if(fileLink) {
        fileLink.click();
        fileLink.querySelector(".accordion-body").classList.add("accordion-active");
      } else {
        const url = new URL(window.location.href);
        url.searchParams.delete("filename");
        window.history.replaceState({}, document.title, url);
        showToast("file_404");
      }
    }

    window.onscroll = function() {scrollFunction()};
  })
</script>
<script>
  // Whole bunch of functions
  function scrollFunction() {
    let mybutton = document.getElementById("scrollToTop");
    if (document.body.scrollTop > 500 || document.documentElement.scrollTop > 500) {
      mybutton.style.display = "block";
    } else {
      mybutton.style.display = "none";
    }
  }

  // When the user clicks on the button, scroll to the top of the document
  function topFunction() {
    document.body.scrollTop = 0; // For Safari
    document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
  }

  function showToast(selector) {
    // Get the snackbar DIV
    var x = document.getElementById(selector);

    // Add the "show" class to DIV
    x.className = "show";

    // After 3 seconds, remove the show class from DIV
    setTimeout(function(){ x.className = x.className.replace("show", ""); }, 3000);
  }

  function waitForElm(selector) {
    return new Promise(resolve => {
        if (document.querySelector(selector)) {
            return resolve(document.querySelector(selector));
        }

        const observer = new MutationObserver(mutations => {
            if (document.querySelector(selector)) {
                resolve(document.querySelector(selector));
                observer.disconnect();
            }
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    });
  }

  function addEventListenerToFileLinks() {
    const allFileLinks = document.querySelectorAll("a[data-filename]");

    allFileLinks.forEach((fileLink) => {
      fileLink.addEventListener("click", (event) => {
        const allAccordionCollapse = document.querySelectorAll(".accordion-body");
        allAccordionCollapse.forEach((accordionCollapse) => {
          accordionCollapse.classList.remove("accordion-active");
        });

        const accordionCollapse = fileLink.querySelector(".accordion-body");
        accordionCollapse.classList.add("accordion-active");
      });
    });
  }
</script>
