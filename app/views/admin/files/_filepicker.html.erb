<div class="accordion">
  <div class="accordion-item d-flex">
    <div class="accordion-collapse show add-new-file w-100" aria-labelledby="headingOne">
      <a data-bs-toggle="modal" data-bs-target="#createFileModal" href="#" class="w-50">
        <div class="accordion-body d-flex align-items-center">
          <i class="bi fs-4 bi-plus-square"></i>
          &nbsp;
          File
        </div>
      </a>
    </div>
    <div class="accordion-collapse show add-new-file d-flex w-100" aria-labelledby="headingOne">
      <a data-bs-toggle="modal" data-bs-target="#createFolderModal" href="#" class="w-100">
        <div class="accordion-body d-flex align-items-center">
          <i class="bi fs-4 bi-plus-square"></i>
          &nbsp;
          Folder
        </div>
      </a>
    </div>
  </div>
  <% @site_files_and_folders.each do |item| %>
    <% if item["type"] == "file" %>
      <div class="accordion-item">
        <div class="accordion-collapse show" aria-labelledby="headingOne">
          <!-- Using Turboframes, when the file is clicked, fetch the _editor partial -->
          <a data-filename="<%= item["name"] %>" data-turbo-frame="_top" data-turbo-stream href="/admin/sites/<%= @site.name %>/files/editor?file_name=<%= item["name"] %>">
            <div class="accordion-body d-flex justify-content-between">
              <div>
                <% unless item["name"].nil? %>
                  <% if item["name"].include?(".css") %>
                    <i class="fs-4 bi bi-filetype-css"></i>
                  <% elsif item["name"].include?(".js") %>
                    <i class="fs-4 bi bi-filetype-js"></i>
                  <% elsif item["name"].include?(".html") %>
                    <i class="fs-4 bi bi-filetype-html"></i>
                  <% elsif item["name"].include?(".png") or item["name"].include?(".jpeg") or item["name"].include?(".gif") or item["name"].include?(".webp") %>
                    <i class="fs-4 bi bi-file-image"></i>
                  <% else %>
                    <i class="fs-4 bi bi-file-code"></i>
                  <% end %>
                <% end %>
                <%= item["name"] %>
              </div>
              <div class="d-flex file-icons-container" data-controller="file">
                <% unless item["name"].include?("index") or item["name"].include?("404") %>
                  <!-- Edit file -->
                  <% if item["type"] == "file" %>
                    <div data-action="click->file#openRenameFileModal" data-bs-target="#renameFileModal" data-bs-toggle="modal" class="div-edit-toggle mx-3 fs-5">
                      <i class="bi bi-pencil"></i>
                    </div>
                  <% end %>
                  <!-- Delete file -->
                  <div data-action="click->file#openDeleteFileModal" class="fs-5" data-bs-target="#deleteFileModal" data-bs-toggle="modal">
                    <i class="bi bi-trash3"></i>
                  </div>
                <% else %>
                  <div class="fs-5" data-bs-target="#mainOr404" data-bs-toggle="modal">
                    <i class="bi bi-question-lg"></i>
                  </div>
                <% end %>
              </div>
            </div>
          </a>
        </div>
      </div>
    <% else %>
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_<%= item["name"] %>" aria-expanded="false" aria-controls="collapseOne">
            <i class="fs-4 bi bi-folder-fill"></i>&nbsp;<%= item["name"] %>
          </button>
        </h2>
        <div data-controller="file" id="collapse_<%= item["name"] %>" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
          <a data-bs-toggle="modal" data-bs-target="#createFileModal" data-action="click->file#openNewFileInFolderModal" href="#" data-folder="<%= item["name"] %>">
            <div class="accordion-body d-flex align-items-center">
              <i class="bi fs-4 bi-plus-square"></i>
              &nbsp;
              New file within <%= item["name"] %>
            </div>
          </a>
          <% item["files"].each do |folder_file| %>
            <a data-filename="<%= item["name"] %>/<%= folder_file["name"] %>" data-turbo-frame="_top" data-turbo-stream href="/admin/sites/<%= @site.name %>/files/editor?file_name=<%= item["name"] %>/<%= folder_file["name"] %>">
              <div class="accordion-body d-flex justify-content-between">
                <div>
                  <% unless folder_file["name"].nil? %>
                    <% if folder_file["name"].include?(".css") %>
                      <i class="fs-4 bi bi-filetype-css"></i>
                    <% elsif folder_file["name"].include?(".js") %>
                      <i class="fs-4 bi bi-filetype-js"></i>
                    <% elsif folder_file["name"].include?(".html") %>
                      <i class="fs-4 bi bi-filetype-html"></i>
                    <% else %>
                      <i class="fs-4 bi bi-file-code"></i>
                    <% end %>
                  <% end %>
                  <%= folder_file["name"] %>
                </div>
                <div class="d-flex file-icons-container" data-controller="file">
                  <% unless folder_file["name"].include?("index") %>
                    <!-- Edit file -->
                    <% if folder_file["type"] == "file" %>
                      <div data-action="click->file#openRenameFileModal" data-bs-target="#renameFileModal" data-bs-toggle="modal" class="div-edit-toggle mx-3 fs-5">
                        <i class="bi bi-pencil"></i>
                      </div>
                    <% end %>
                    <!-- Delete file -->
                    <div data-action="click->file#openDeleteFileModal" class="fs-5" data-bs-target="#deleteFileModal" data-bs-toggle="modal">
                      <i class="bi bi-trash3"></i>
                    </div>
                  <% end %>
                </div>
              </div>
            </a>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
<script>
  allFilePickerLinks = document.querySelectorAll("a[data-filename]");

  allFilePickerLinks.forEach((fileLink) => {
    fileLink.addEventListener("click", (event) => {
      let allAccordionCollapse = document.querySelectorAll(".accordion-body");
      allAccordionCollapse.forEach((accordionCollapse) => {
        accordionCollapse.classList.remove("accordion-active");
      });

      let accordionCollapse = fileLink.querySelector(".accordion-body");
      accordionCollapse.classList.add("accordion-active");
    });
  });
</script>
