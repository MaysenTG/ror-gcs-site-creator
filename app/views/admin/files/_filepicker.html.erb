<% site = @site || local_assigns[:site] %>
<% items = @site_files_and_folders || local_assigns[:site_files_and_folders] || [] %>
<% site_name = site.respond_to?(:name) ? site.name : site["name"] %>
<% site_id = site.respond_to?(:id) ? site.id : site["id"] %>
<% active_file = params[:filename].presence || params[:file_name].presence %>

<div
  class="filetree"
  data-controller="filetree"
  data-filetree-site-name-value="<%= site_name %>"
  data-site-id="<%= site_id %>"
>
  <div class="filetree__toolbar">
    <button type="button" class="filetree__tool" data-action="click->filetree#startNewFile" title="New file">
      <i class="bi bi-file-earmark-plus"></i>
      File
    </button>
    <button type="button" class="filetree__tool" data-action="click->filetree#startNewFolder" title="New folder">
      <i class="bi bi-folder-plus"></i>
      Folder
    </button>
  </div>

  <div class="filetree__tree" data-filetree-target="tree">
    <% items.each do |item| %>
      <% if item["type"] == "file" %>
        <% locked = Site::SYSTEM_FILES.include?(item["name"]) %>
        <div
          class="filetree__row <%= 'accordion-active' if active_file == item['name'] %>"
          data-file-row
          data-filename="<%= item["name"] %>"
          data-locked="<%= locked %>"
        >
          <a
            class="filetree__link"
            data-filename="<%= item["name"] %>"
            data-turbo-stream
            href="/admin/sites/<%= site_name %>/files/editor?file_name=<%= ERB::Util.url_encode(item["name"]) %>"
          >
            <% if item["name"].end_with?(".css") %>
              <i class="bi bi-filetype-css" aria-hidden="true"></i>
            <% elsif item["name"].end_with?(".js", ".mjs") %>
              <i class="bi bi-filetype-js" aria-hidden="true"></i>
            <% elsif item["name"].end_with?(".html", ".htm") %>
              <i class="bi bi-filetype-html" aria-hidden="true"></i>
            <% elsif item["name"].match?(/\.(png|jpe?g|gif|webp|svg)\z/i) %>
              <i class="bi bi-file-earmark-image" aria-hidden="true"></i>
            <% else %>
              <i class="bi bi-file-earmark-code" aria-hidden="true"></i>
            <% end %>
            <span class="filetree__name"><%= item["name"] %></span>
          </a>
          <div class="filetree__actions">
            <% unless locked %>
              <button type="button" class="filetree__icon-btn" data-action="click->filetree#startRename" title="Rename">
                <i class="bi bi-pencil"></i>
              </button>
              <button type="button" class="filetree__icon-btn" data-action="click->filetree#openDelete" title="Delete">
                <i class="bi bi-trash3"></i>
              </button>
            <% else %>
              <button type="button" class="filetree__icon-btn" data-bs-toggle="modal" data-bs-target="#mainOr404" title="About this file">
                <i class="bi bi-question-lg"></i>
              </button>
            <% end %>
          </div>
        </div>
      <% else %>
        <div
          class="filetree__folder"
          data-folder-row
          data-filename="<%= item["name"] %>"
          data-open="false"
        >
          <div class="filetree__row filetree__row--folder">
            <button type="button" class="filetree__link filetree__folder-toggle" data-action="click->filetree#toggleFolder">
              <i class="bi bi-chevron-right filetree__chevron"></i>
              <i class="bi bi-folder-fill"></i>
              <span class="filetree__name"><%= item["name"] %></span>
            </button>
            <div class="filetree__actions">
              <button
                type="button"
                class="filetree__icon-btn"
                data-folder="<%= item["name"] %>"
                data-action="click->filetree#startNewFile"
                title="New file in folder"
              >
                <i class="bi bi-file-earmark-plus"></i>
              </button>
              <button type="button" class="filetree__icon-btn" data-action="click->filetree#openDelete" title="Delete folder">
                <i class="bi bi-trash3"></i>
              </button>
            </div>
          </div>

          <div class="filetree__children">
            <% Array(item["files"]).each do |folder_file| %>
              <% nested = "#{item["name"]}/#{folder_file["name"]}" %>
              <% nested_locked = folder_file["name"].include?("index") %>
              <div
                class="filetree__row <%= 'accordion-active' if active_file == nested %>"
                data-file-row
                data-filename="<%= nested %>"
                data-locked="<%= nested_locked %>"
              >
                <a
                  class="filetree__link"
                  data-filename="<%= nested %>"
                  data-turbo-stream
                  href="/admin/sites/<%= site_name %>/files/editor?file_name=<%= ERB::Util.url_encode(nested) %>"
                >
                  <% if folder_file["name"].end_with?(".css") %>
                    <i class="bi bi-filetype-css" aria-hidden="true"></i>
                  <% elsif folder_file["name"].end_with?(".js", ".mjs") %>
                    <i class="bi bi-filetype-js" aria-hidden="true"></i>
                  <% elsif folder_file["name"].end_with?(".html", ".htm") %>
                    <i class="bi bi-filetype-html" aria-hidden="true"></i>
                  <% else %>
                    <i class="bi bi-file-earmark-code" aria-hidden="true"></i>
                  <% end %>
                  <span class="filetree__name"><%= folder_file["name"] %></span>
                </a>
                <div class="filetree__actions">
                  <% unless nested_locked %>
                    <button type="button" class="filetree__icon-btn" data-action="click->filetree#startRename" title="Rename">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button" class="filetree__icon-btn" data-action="click->filetree#openDelete" title="Delete">
                      <i class="bi bi-trash3"></i>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

