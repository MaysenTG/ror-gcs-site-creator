<div class="image-pane is-booting">
  <div class="image-pane__bar">
    <div class="image-pane__title">
      <h3 class="image-pane__name"><%= @file_name %></h3>
      <% a_href = site_preview_url(@site["name"], path: @file_name) %>
      <a target="_blank" href="<%= a_href %>" class="btn btn-ghost btn-sm" aria-label="Preview image">
        <i class="bi bi-eye"></i> Preview
      </a>
    </div>
  </div>

  <div class="image-pane__stage">
    <div class="image-pane__boot" data-image-boot>
      <%= render partial: "layouts/snippets/image_loading", locals: { filename: @file_name } %>
    </div>
    <img
      src="<%= @image_url %>"
      alt="<%= @file_name %>"
      class="image-pane__img"
      data-image-live
      decoding="async"
    >
  </div>
</div>
<script>
  (function () {
    const path = <%= raw @file_name.to_json %>;
    const url = new URL(window.location.href);
    url.searchParams.set("filename", path);
    window.history.replaceState({}, "", url);

    const pane = document.querySelector(".image-pane.is-booting");
    const img = pane?.querySelector("[data-image-live]");
    if (!pane || !img) return;

    const reveal = () => {
      pane.classList.remove("is-booting");
      pane.querySelector("[data-image-boot]")?.remove();
      img.classList.add("is-ready");
    };

    if (img.complete && img.naturalWidth > 0) {
      reveal();
    } else {
      img.addEventListener("load", reveal, { once: true });
      img.addEventListener("error", reveal, { once: true });
    }

    const tree = document.querySelector("[data-controller~='filetree']");
    const controller = tree && window.Stimulus
      ? window.Stimulus.getControllerForElementAndIdentifier(tree, "filetree")
      : null;
    if (controller?.setActiveFile) {
      controller.setActiveFile(path);
    } else {
      document.querySelectorAll(".filetree__row[data-file-row]").forEach((row) => {
        row.classList.toggle("accordion-active", row.dataset.filename === path);
      });
    }
  })();
</script>
