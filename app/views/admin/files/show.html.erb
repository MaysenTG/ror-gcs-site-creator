<% content_for :head do %>
  <%= render partial: "layouts/codemirror_styles" %>
<% end %>

<div class="page-shell page-shell--wide">
  <div class="mb-3">
    <a href="/admin/sites/<%= @site["name"] %>" class="btn btn-ghost btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
  </div>
  <div class="surface-panel">
    <%= render partial: "admin/files/editor", locals: { file_contents: @file_contents, file_name: @file_name, site: @site } %>
  </div>
</div>
<%= render partial: "layouts/codemirror_scripts" %>
<script>
  (async function () {
    const wait = () =>
      new Promise((resolve, reject) => {
        const start = Date.now();
        const tick = () => {
          if (window.CodeMirror?.fromTextArea) return resolve();
          if (Date.now() - start > 8000) return reject(new Error("CodeMirror failed to load"));
          requestAnimationFrame(tick);
        };
        tick();
      });

    function revealEditorPane() {
      const pane = document.querySelector(".editor-pane.is-booting") || document.getElementById("file_content")?.closest(".editor-pane");
      if (!pane) return;
      pane.classList.remove("is-booting");
      pane.querySelector("[data-editor-boot]")?.remove();
    }

    try {
      await wait();
    } catch (_e) {
      revealEditorPane();
      return;
    }

    const area = document.getElementById("file_content");
    if (!area) return;
    if (area.parentElement?.querySelector(".CodeMirror")) {
      revealEditorPane();
      return;
    }
    const ext = (area.dataset.filename || "").split(".").pop();
    let mode = "htmlmixed";
    if (ext === "js" || ext === "mjs") mode = "text/javascript";
    else if (ext === "css") mode = "text/css";
    const editor = window.CodeMirror.fromTextArea(area, {
      mode,
      lineNumbers: true,
      autoCloseTags: true,
      autoCloseBrackets: true,
      matchBrackets: true,
      styleActiveLine: true,
      indentUnit: 2,
      tabSize: 2,
    });
    editor.on("change", (cm) => {
      area.value = cm.getValue();
      const saveBtn = document.querySelector("#save-file-btn");
      if (saveBtn) saveBtn.disabled = false;
    });
    requestAnimationFrame(() => {
      editor.refresh();
      revealEditorPane();
      requestAnimationFrame(() => editor.refresh());
    });
  })();
</script>
