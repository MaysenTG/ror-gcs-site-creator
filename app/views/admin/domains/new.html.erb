<div class="page-shell">
  <div class="page-header">
    <div>
      <a href="/admin/sites/<%= @site.name %>/domains" class="btn btn-ghost btn-sm mb-2"><i class="bi bi-arrow-left"></i> Domains</a>
      <h1>Add a domain</h1>
      <p class="mb-0">Enter the hostname you want to point at this site.</p>
    </div>
  </div>

  <div class="surface-panel create-site__panel">
    <%= render "form", domain: @domain %>
  </div>
</div>
