<div class="page-shell">
  <div class="page-header">
    <div>
      <a href="/admin/sites/<%= @site.name %>" class="btn btn-ghost btn-sm mb-2"><i class="bi bi-arrow-left"></i> Editor</a>
      <h1>Domains</h1>
      <p class="mb-0">Point a custom domain at <strong><%= @site.name %></strong>.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="<%= site_preview_url(@site) %>" target="_blank" rel="noopener" class="btn btn-outline-primary">Open site</a>
      <a href="/admin/sites/<%= @site.name %>/domains/new" class="btn btn-primary">Add domain</a>
    </div>
  </div>

  <div id="domains" class="domains-list">
    <% if @domains.blank? %>
      <div class="empty-state surface-panel">
        <h2>No domains yet</h2>
        <p>Add a custom domain to serve this site on your own URL.</p>
        <a href="/admin/sites/<%= @site.name %>/domains/new" class="btn btn-primary">Add domain</a>
      </div>
    <% else %>
      <% @domains.each_with_index do |domain, index| %>
        <article class="surface-panel domain-card">
          <div class="domain-card__top">
            <div>
              <h2 class="h4 mb-1">
                <a target="_blank" rel="noopener" href="https://<%= domain.domain %>"><%= domain.domain %></a>
              </h2>
              <p class="text-muted mb-0 small">Custom domain</p>
            </div>
            <%= button_to "Delete", admin_domain_url(@site.name, domain), method: :delete, class: "btn btn-ghost btn-sm text-danger" %>
          </div>

          <% if index == 0 %>
            <div class="alert alert-info mb-0 mt-3" role="alert">
              Add this DNS record at your registrar:
              <ul class="mb-2 mt-2">
                <li><strong>Type:</strong> A</li>
                <li><strong>Name:</strong> <% if domain.domain.split(".").length == 3 %><%= domain.domain.split(".")[0] %><% else %><%= domain.domain %> (or <code>@</code>)<% end %></li>
                <li><strong>Value:</strong> <%= @a_record_ip %></li>
              </ul>
              DNS can take up to 24 hours. On Cloudflare, set SSL/TLS mode to <strong>Flexible</strong>.
            </div>
          <% end %>
        </article>
      <% end %>
    <% end %>
  </div>
</div>
