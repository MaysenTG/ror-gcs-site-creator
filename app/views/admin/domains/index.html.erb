<div class="page-shell">
  <div class="page-header">
    <div>
      <a href="/admin/sites/<%= @site.name %>" class="btn btn-ghost btn-sm mb-2"><i class="bi bi-arrow-left"></i> Editor</a>
      <h1>Domains</h1>
      <p class="mb-0">Point a custom domain at <strong><%= @site.name %></strong>.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="<%= site_preview_url(@site) %>" target="_blank" rel="noopener" class="btn btn-outline-primary">Open site</a>
      <a href="/admin/sites/<%= @site.name %>/domains/new" class="btn btn-primary">Add domain</a>
    </div>
  </div>

  <div id="domains" class="domains-list">
    <% if @domains.blank? %>
      <div class="empty-state surface-panel">
        <h2>No domains yet</h2>
        <p>Add a custom domain to serve this site on your own URL.</p>
        <a href="/admin/sites/<%= @site.name %>/domains/new" class="btn btn-primary">Add domain</a>
      </div>
    <% else %>
      <% @domains.each do |domain| %>
        <%
          record_name = domain.domain.split(".").length >= 3 ? domain.domain.split(".").first : "@"
        %>
        <article
          class="surface-panel domain-card"
          data-controller="dns-status"
          data-dns-status-url-value="<%= dns_check_admin_domain_path(@site.name, domain) %>"
          data-dns-status-cooldown-ms-value="<%= @dns_refresh_ms %>"
        >
          <div class="domain-card__top">
            <div>
              <h2 class="h4 mb-1">
                <a target="_blank" rel="noopener" href="https://<%= domain.domain %>"><%= domain.domain %></a>
              </h2>
              <p class="text-muted mb-0 small">Custom domain</p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-start">
              <span class="dns-badge dns-badge--pending" data-dns-status-target="badge">Checking…</span>
              <%= button_to "Delete", admin_domain_url(@site.name, domain), method: :delete, class: "btn btn-ghost btn-sm text-danger" %>
            </div>
          </div>

          <div class="dns-status dns-status--pending mt-3" data-dns-status-target="status">
            <div class="dns-status__header">
              <div>
                <h3 class="h6 mb-1">DNS status</h3>
                <p class="mb-0 small" data-dns-status-target="summary">Looking up DNS records…</p>
              </div>
              <div class="dns-status__actions">
                <button
                  type="button"
                  class="btn btn-outline-primary btn-sm"
                  data-dns-status-target="refresh"
                  data-action="dns-status#refresh"
                  disabled
                >Refresh DNS</button>
                <span class="dns-status__cooldown small text-muted" data-dns-status-target="cooldown"></span>
              </div>
            </div>

            <ul class="dns-records" data-dns-status-target="records">
              <% if @a_record_ip.present? %>
                <li class="dns-record dns-record--pending">
                  <div class="dns-record__meta">
                    <span class="dns-record__type">A</span>
                    <span class="dns-record__name"><%= record_name %></span>
                    <span class="dns-record__expected"><%= @a_record_ip %></span>
                  </div>
                  <div class="dns-record__result">
                    <span class="dns-record__icon" aria-hidden="true">…</span>
                    <span>Checking A record…</span>
                  </div>
                </li>
              <% end %>
              <li class="dns-record dns-record--pending">
                <div class="dns-record__meta">
                  <span class="dns-record__type">CNAME</span>
                  <span class="dns-record__name"><%= record_name %></span>
                  <span class="dns-record__expected"><%= @cname_target %></span>
                </div>
                <div class="dns-record__result">
                  <span class="dns-record__icon" aria-hidden="true">…</span>
                  <span>Checking CNAME…</span>
                </div>
              </li>
            </ul>

            <p class="dns-hint mb-0 mt-3 small text-muted">
              <% if @a_record_ip.present? %>
                Set an <strong>A</strong> record to <code><%= @a_record_ip %></code>
                or a <strong>CNAME</strong> to <code><%= @cname_target %></code>.
              <% else %>
                Set a <strong>CNAME</strong> to <code><%= @cname_target %></code>
                (or configure <code>CUSTOM_DOMAIN_IP</code> for an A record).
              <% end %>
              DNS can take up to 24 hours. On Cloudflare, set SSL/TLS mode to <strong>Flexible</strong>.
            </p>
          </div>
        </article>
      <% end %>
    <% end %>
  </div>
</div>
