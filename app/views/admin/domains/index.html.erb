<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-secondary" href="/admin/sites/<%= @site.name %>">Back to site</a>
    <h2 class="mb-3">All domains</h2>
    <a class="btn btn-primary" href="/admin/sites/<%= @site.name %>/domains/new">Add domain</a>
  </div>
  <p style="color: green"><%= notice %></p>
  <div id="domains">
    <% @domains.each_with_index do |domain, index| %>
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title"><%= domain.domain %></h5>
          <%= button_to "Destroy this domain", admin_domain_url(@site.name, domain), method: :delete, class: "btn btn-danger" %>
          <% if index == 0 %>
            <div class="alert alert-info mt-3" role="alert">
              To use this domain, you must add the following DNS records on your domain's DNS settings page:
              <ul>
                <li><strong>Type: </strong>A Record</li>
                <li><strong>Name: </strong><%= domain.domain %></li>
                <li><strong>Value: </strong><%= @a_record_ip %></li>
              </ul>
              It may take up to 24 hours for the DNS records to update.
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <% if @domains.length <= 0 %>
      <p>There are no domains for this site.</p>
    <% end %>
  </div>
</div>
<%# Add a container to display the number of domains %>
