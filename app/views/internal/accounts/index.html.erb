<div class="page-shell page-shell--wide">
  <div class="page-header">
    <div>
      <h1>Accounts</h1>
      <p>Search and open customer accounts, plans, and sites.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="<%= internal_root_path %>" class="btn btn-ghost">Ops dashboard</a>
      <a href="<%= internal_new_account_path %>" class="btn btn-primary">Create account</a>
    </div>
  </div>

  <div class="surface-panel mb-3">
    <form
      data-controller="search"
      action="<%= internal_accounts_search_path %>"
      class="internal-search"
      data-turbo="true"
      method="get"
    >
      <input
        data-action="input->search#debounceSearchInput"
        type="search"
        name="q"
        class="form-control"
        placeholder="Search by name, email, or plan…"
        value="<%= params[:q] %>"
      >
    </form>
  </div>

  <%= turbo_frame_tag "accounts_list", target: "_top", class: "account-results-wrapper" do %>
    <%= render partial: "internal/accounts/accounts" %>
  <% end %>

  <div class="account-load-placeholder d-none">
    <div class="site-card-grid">
      <% 4.times do %>
        <article class="site-card site-card--skeleton">
          <h5 class="placeholder-glow mb-2"><span class="placeholder col-7"></span></h5>
          <p class="placeholder-glow mb-1"><span class="placeholder col-9"></span></p>
          <p class="placeholder-glow mb-0"><span class="placeholder col-5"></span></p>
        </article>
      <% end %>
    </div>
  </div>
</div>
