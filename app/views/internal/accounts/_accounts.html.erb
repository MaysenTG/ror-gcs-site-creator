<% if @query.present? %>
  <p class="text-muted mb-3">
    Query <strong>"<%= @query %>"</strong> returned <%= @pagy.count %> account<%= @pagy.count == 1 ? "" : "s" %>.
  </p>
<% else %>
  <p class="text-muted mb-3"><%= @pagy.count %> account<%= @pagy.count == 1 ? "" : "s" %> total</p>
<% end %>

<% if @accounts.blank? %>
  <div class="empty-state surface-panel">
    <h2>No accounts found</h2>
    <p>Try a broader search, or create a new account.</p>
    <a href="<%= internal_new_account_path %>" class="btn btn-primary">Create account</a>
  </div>
<% else %>
  <div class="site-card-grid mb-3">
    <% @accounts.each do |account| %>
      <a href="<%= internal_account_path(account) %>" class="site-card site-card--link">
        <div class="site-card__top">
          <div>
            <h2 class="site-card__title"><%= account.name.presence || "Unnamed account" %></h2>
            <span class="site-card__url"><%= account.email %></span>
          </div>
          <% if account.admin? %>
            <span class="internal-pill">Admin</span>
          <% end %>
        </div>
        <div class="site-card__meta">
          <span><%= account.plan_handle.to_s.titleize %></span>
          <span><%= internal_account_sites_label(account) %> sites</span>
        </div>
      </a>
    <% end %>
  </div>
  <div class="internal-pagination">
    <%== @pagy.series_nav(:bootstrap) %>
  </div>
<% end %>
