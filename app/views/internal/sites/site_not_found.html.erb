<% full_site_domain = @site.name+".maysengreenwood.com" %>
<a class="btn btn-secondary my-3 mx-5" href="/internal/accounts/<%= @account_id %>">Back to account</a>
<h1 style="margin-top: 4rem;" class="mb-3 text-center">Site details</h1>
<div class="container">
  <h2 class="mb-3">Oh no! An error occured while viewing <%= full_site_domain %></h2>
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">The site <strong><%= full_site_domain %></strong> has a Database entry, but doesn't have a Cloud bucket</h5>
      <p class="card-text">You'll need to either create the missing bucket, or delete this site's DB entry</p>
      <div class="d-flex justify-content-between">
        <form action="/internal/accounts/<%= @account_id %>/sites/<%= @site.id %>/create_bucket" method="POST" data-turbo="true">
          <input type="hidden" name="site_name" value="<%= @site.name %>s">
          <button type="submit" class="btn btn-primary">Create Google Cloud bucket</button>
        </form>
        <form action="/internal/accounts/<%= @account_id %>/sites/<%= @site.id %>/delete_site" method="DELETE" data-turbo="true">
          <button type="submit" class="btn btn-danger">Delete site</button>
        </form>
      </div>
    </div>
  </div>
</div>
