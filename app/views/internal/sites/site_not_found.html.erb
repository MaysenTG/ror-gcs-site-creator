<% full_site_domain = "#{@site.name}.#{SiteStorage::DOMAIN_NAME}" %>

<div class="page-shell">
  <div class="page-header">
    <div>
      <a href="<%= internal_account_path(@account_id) %>" class="btn btn-ghost btn-sm mb-2"><i class="bi bi-arrow-left"></i> Account</a>
      <h1>Missing storage</h1>
      <p>Database record exists for <strong><%= full_site_domain %></strong>, but the bucket was not found.</p>
    </div>
  </div>

  <div class="surface-panel">
    <p class="mb-4">Create the missing bucket, or delete the orphaned site record.</p>
    <div class="d-flex flex-wrap gap-2 justify-content-between">
      <form action="<%= internal_create_account_site_bucket_path(@account_id, @site) %>" method="post" data-turbo="true">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="site_name" value="<%= @site.name %>">
        <button type="submit" class="btn btn-primary">Create R2 bucket</button>
      </form>
      <form action="<%= internal_delete_account_site_path(@account_id, @site) %>" method="post" data-turbo="true">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit" class="btn btn-danger" data-turbo-confirm="Delete this site record?">Delete site</button>
      </form>
    </div>
  </div>
</div>
