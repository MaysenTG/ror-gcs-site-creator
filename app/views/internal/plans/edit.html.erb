<% if notice %>
  <div class="alert alert-warning alert-dismissible fade show" role="alert">
    <%= notice %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
<a class="btn btn-secondary my-3 mx-5" href="/internal/plans">Back to plans</a>
<h1 style="margin-top: 4rem;" class="mb-3 text-center">Plan details</h1>
<div class="container">
  <h2 class="mb-3">Viewing <%= @plan.name %></h2>
  <div class="card">
    <div class="card-header">
      Plan information
    </div>
    <div class="card-body">
      <form action="/internal/plans/<%= @plan.id %>" data-turbo="true" id="edit-plan-form" method="put">
        <div class="row">
          <div class="col-6">
            <h5 class="card-title mb-3">
              Name:
              <input type="text" class="form-control" name="plan[name]" value="<%= @plan.name %>"/>
            </h5>
          </div>
          <div class="col-6">
            <h5 class="card-title mb-3">
              Plan handle:
              <input type="text" disabled class="form-control" value="<%= @plan.plan_handle %>"/>
            </h5>
          </div>
          <div class="col-6">
            <h5 class="card-title mb-3">
              Max sites:
              <input type="number" class="form-control" name="plan[max_sites]" value="<%= @plan.max_sites %>"/>
            </h5>
          </div>
          <div class="col-6">
            <h5 class="card-title mb-3">
              Max site size:
              <input type="number" class="form-control" name="plan[max_site_size]" value="<%= @plan.max_site_size %>"/>
            </h5>
          </div>
          <div class="col-12">
            <h5 class="card-title mb-3">
              Plan price (in NZD/month):
              <input type="number" class="form-control" name="plan[price]" value="<%= @plan.price %>"/>
            </h5>
          </div>
          <button type="submit" class="d-none btn btn-primary">Save changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    let inputs = document.querySelectorAll("input")
    let saveButton = document.querySelector("#edit-plan-form button[type='submit']")
    inputs.forEach(input => {
      input.addEventListener("input", function() {
        console.log("input")
        console.log(saveButton)
        saveButton.classList.remove("d-none");
      })
    })
  });
  
  document.addEventListener("turbo:before-fetch-response", function() {
    let saveButton = document.querySelector("#edit-plan-form button[type='submit']");
    if(saveButton) {
      saveButton.classList.add("d-none");
    }
  })
</script>