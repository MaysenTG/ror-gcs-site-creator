<div class="page-shell">
  <div class="page-header">
    <div>
      <h1>Plans</h1>
      <p>Edit plan limits and pricing for customer accounts.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="<%= internal_root_path %>" class="btn btn-ghost">Ops dashboard</a>
      <a href="<%= new_internal_plan_path %>" class="btn btn-primary">Create plan</a>
    </div>
  </div>

  <% if @plans.blank? %>
    <div class="empty-state surface-panel">
      <h2>No plans yet</h2>
      <p>Create the first plan to attach to accounts.</p>
      <a href="<%= new_internal_plan_path %>" class="btn btn-primary">Create plan</a>
    </div>
  <% else %>
    <div class="site-card-grid">
      <% @plans.each do |plan| %>
        <a href="<%= edit_internal_plan_path(plan) %>" class="site-card site-card--link">
          <div class="site-card__top">
            <div>
              <h2 class="site-card__title"><%= plan.name %></h2>
              <span class="site-card__url"><%= plan.plan_handle %></span>
            </div>
          </div>
          <div class="site-card__meta">
            <span><%= plan.max_sites %> sites</span>
            <span><%= plan.max_site_size %> MB</span>
          </div>
          <div class="site-card__meta">
            <span>$<%= plan.price.to_i %> NZD / month</span>
            <span><%= plan.accounts.size %> accounts</span>
          </div>
        </a>
      <% end %>
    </div>
  <% end %>
</div>
