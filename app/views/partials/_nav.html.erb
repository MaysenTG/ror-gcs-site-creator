<% if current_account %>
  <% action_url = "/accounts/sign_out/" + current_account.id.to_s %>
  <form id="sign-out-account-form" class="button_to" method="post" action="/accounts/sign_out">
    <input type="hidden" name="_method" value="delete" autocomplete="off">
    <input type="hidden" name="account_id" value="<%= current_account.id %>">
    <input type="hidden" name="account[id]" value="<%= current_account.id %>">
    <input type="hidden" name="authenticity_token" value="S6oYWaQcvFvqV90VJMgK21C8raIpn_4Hc4-8jnRFbERv105hjGuncmIXFIUpFk5gcJ5boa-3im0fTtDzfvb-dg" autocomplete="off">
  </form>
<% end %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/"><img src="/images/static-site-generator-logo.png" alt="logo" class="img-fluid image-fluid" width="100"></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% unless current_account %>
          <li class="nav-item">
            <a class="nav-link <% if request.path == "/" %>active<% end %>" aria-current="page" href="/">Home</a>
          </li>
        <% end %>
        <% if current_account %>
          <li class="nav-item">
            <a class="nav-link <% if request.path == "/admin/sites" or (controller_name == "sites" and action_name == "show") or (controller_name == "files") %>active<% end %>" href="/admin/sites">View your sites</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <% if request.path == "/admin/sites/new" %>active<% end %>" href="/admin/sites/new">Create a new site</a>
          </li>
          <% if current_account.admin %>
            <li class="nav-item">
              <a class="nav-link <% if request.path.include?("/internal/account") %>active<% end %>" href="/internal/accounts">Accounts internal</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <% if request.path.include?("/internal/plan") %>active<% end %>" href="/internal/plans">Plans internal</a>
            </li>
          <% end %>
        <% end %>
      </ul>
      <% if current_account %>
        <ul class="navbar-nav ms-auto mb-2 mx-5 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link <% if request.path.include?("account") %>active<% end %> dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Your account
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item" href="/admin/sites/new">Create a new site</a></li>
              <li><a class="dropdown-item <% if request.path == "/accounts/edit" %>active<% end %>" href="/accounts/edit">Edit your account</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><button type="submit" form="sign-out-account-form" class="dropdown-item">Sign out</button></li>
            </ul>
          </li>
        </ul>
      <% else %>
        <ul class="navbar-nav ms-auto mb-2 mx-5 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link <% if request.path == "/accounts/sign_in" %>active<% end %>" href="/accounts/sign_in">Sign in</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <% if request.path == "/accounts/sign_up" %>active<% end %>" href="/accounts/sign_up">Create an account</a>
          </li>
        </ul>
      <% end %>
    </div>
  </div>
</nav>
