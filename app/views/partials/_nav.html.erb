<% if current_account %>
  <%= button_to "Sign out",
      destroy_account_session_path,
      method: :delete,
      form: { id: "sign-out-account-form", class: "d-none" },
      id: "sign-out-account-submit" %>
<% end %>

<nav class="navbar navbar-expand-lg navbar-light site-nav">
  <div class="container">
    <a class="navbar-brand" href="/">Gusto <span>Cloud</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% unless current_account %>
          <li class="nav-item">
            <a class="nav-link <%= "active" if request.path == "/" %>" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= "active" if request.path == "/home/pricing" || request.path == "/pricing" %>" href="/home/pricing">Pricing</a>
          </li>
        <% end %>
        <% if current_account %>
          <li class="nav-item">
            <a class="nav-link <%= "active" if request.path == "/admin/sites" || (controller_name == "sites" && action_name == "show") || controller_name == "files" %>" href="/admin/sites">Your sites</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= "active" if controller_name == "dashboard_hub" || controller_name == "dashboards" %>" href="<%= admin_dashboard_hub_path %>">Dashboards</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= "active" if request.path == "/admin/sites/new" %>" href="/admin/sites/new">New site</a>
          </li>
          <% if current_account.admin %>
            <li class="nav-item">
              <a class="nav-link <%= "active" if request.path.include?("/internal/account") %>" href="/internal/accounts">Accounts</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= "active" if request.path.include?("/internal/plan") %>" href="/internal/plans">Plans</a>
            </li>
          <% end %>
        <% end %>
      </ul>
      <% if current_account %>
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
          <li class="nav-item dropdown">
            <a class="nav-link <%= "active" if request.path.include?("account") %> dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Account
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item <%= "active" if request.path == "/accounts/edit" %>" href="/accounts/edit">Edit account</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><button type="submit" form="sign-out-account-form" class="dropdown-item">Sign out</button></li>
            </ul>
          </li>
        </ul>
      <% else %>
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-2">
          <li class="nav-item">
            <a class="nav-link <%= "active" if request.path == "/accounts/sign_in" %>" href="/accounts/sign_in">Sign in</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-primary btn-sm px-3" href="/accounts/sign_up">Get started</a>
          </li>
        </ul>
      <% end %>
    </div>
  </div>
</nav>
