#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")

  unless File.exist?(".env")
    puts "\n== Creating .env from .env.example =="
    FileUtils.cp ".env.example", ".env"
    puts "Edit .env with your R2 credentials before creating sites."
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Enabling local caching =="
  system "bin/rails dev:cache" unless File.exist?("tmp/caching-dev.txt")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Done =="
  puts "Start the app with:  bundle exec rails s"
  puts "Start Sidekiq with:  bundle exec sidekiq -C config/sidekiq.yml"
  puts "Redis must be running (REDIS_URL in .env)."
end
