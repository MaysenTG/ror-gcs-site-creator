#!/usr/bin/env ruby
# frozen_string_literal: true

# Reads RSpec JSON output and writes a short GitHub Actions job summary.
require "json"

path = ARGV[0] || "tmp/rspec.json"
out = ENV["GITHUB_STEP_SUMMARY"]

unless File.file?(path)
  message = "### Tests\n\nCould not find RSpec results at `#{path}`.\n"
  File.write(out, message, mode: "a") if out && !out.empty?
  warn message
  exit 1
end

data = JSON.parse(File.read(path))
summary = data.fetch("summary", {})
examples = Array(data["examples"])
failures = examples.select { |ex| ex["status"] == "failed" }
pendings = examples.select { |ex| ex["status"] == "pending" }

example_count = summary["example_count"] || examples.size
failure_count = summary["failure_count"] || failures.size
pending_count = summary["pending_count"] || pendings.size
duration = summary["duration"]

lines = []
lines << "### Tests"
lines << ""

if failure_count.to_i.zero?
  lines << "**Successful** — #{example_count} examples, 0 failures"
  lines << "Pending: #{pending_count}" if pending_count.to_i.positive?
  lines << "Duration: #{format('%.2fs', duration)}" if duration
else
  lines << "**Failed** — #{example_count} examples, #{failure_count} failure#{'s' unless failure_count == 1}"
  lines << "Pending: #{pending_count}" if pending_count.to_i.positive?
  lines << "Duration: #{format('%.2fs', duration)}" if duration
  lines << ""
  lines << "#### Failures"
  failures.each_with_index do |ex, i|
    location = ex["file_path"].to_s
    location = "#{location}:#{ex['line_number']}" if ex["line_number"]
    lines << ""
    lines << "#{i + 1}. `#{ex['full_description']}`"
    lines << "   - #{location}"
    message = ex.dig("exception", "message").to_s.strip
    next if message.empty?

    snippet = message.lines.first(8).map(&:rstrip).join("\n")
    lines << "   ```"
    snippet.each_line { |line| lines << line.rstrip }
    lines << "   ```"
  end
end

text = "#{lines.join("\n")}\n"
puts text
File.write(out, text, mode: "a") if out && !out.empty?

exit(failure_count.to_i.zero? ? 0 : 1)
